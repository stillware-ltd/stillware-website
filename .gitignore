# Derived copies of blog heroes, regenerated by scripts/optimize-heroes.mjs on every build and dev run:
# plain resizes (480, 960, 1200 wide) and the 16:9, 4:3 and 1:1 crops (1200x675, 1200x900, 1200x1200)
public/blog/images/*/hero-480.webp
public/blog/images/*/hero-960.webp
public/blog/images/*/hero-1200.webp
public/blog/images/*/hero-1200x675.webp
public/blog/images/*/hero-1200x900.webp
public/blog/images/*/hero-1200x1200.webp
