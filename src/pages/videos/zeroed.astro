---
import Layout from '../../layouts/Layout.astro';
import videos from '../../data/zeroed-videos.json';

// zeroed-videos.json is generated by Marketing/Zeroed/Dashboard/dash.py build (live videos only, newest first).
type Video = { id: string; type: 'long' | 'short' | 'trailer'; title: string; published: string; length?: string; blurb?: string };
const all = videos as Video[];
const longs = all.filter((v) => v.type === 'long' || v.type === 'trailer');
const shorts = all.filter((v) => v.type === 'short');
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<Layout
  title="Zeroed Videos — Envelope Budgeting, Explained"
  description="Watch the Zeroed budgeting videos and Shorts here: the envelope method, cash stuffing on a phone, and how a pay-once offline budgeting app handles it."
  canonical="https://www.stillwareltd.com/videos/zeroed/"
>
  <header class="vid-hero">
    <div class="container">
      <p class="eyebrow">Zeroed on YouTube</p>
      <h1>Envelope budgeting, explained</h1>
      <p class="lead">Every video from the <a href="https://www.youtube.com/@Zeroed-Official" rel="noopener">Zeroed channel</a>, playable here. Method first, app second: each one teaches a budgeting move, then shows the same move inside Zeroed.</p>
    </div>
  </header>

  <section class="vid-section">
    <div class="container">
      <h2>Videos</h2>
      {longs.length === 0 && <p class="note">First video coming soon.</p>}
      <div class="grid">
        {longs.map((v) => (
          <article class="card">
            <button class="player" type="button" data-id={v.id} aria-label={`Play: ${v.title}`}>
              <img src={thumb(v.id)} alt="" loading="lazy" width="480" height="360" />
              <span class="play" aria-hidden="true"></span>
            </button>
            <h3>{v.title}</h3>
            <p class="meta">{fmtDate(v.published)}{v.length ? ` · ${v.length}` : ''}{v.type === 'trailer' ? ' · trailer' : ''}</p>
            {v.blurb && <p class="blurb">{v.blurb}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  {shorts.length > 0 && (
    <section class="vid-section alt">
      <div class="container">
        <h2>Shorts</h2>
        <div class="grid shorts">
          {shorts.map((v) => (
            <article class="card">
              <button class="player portrait" type="button" data-id={v.id} aria-label={`Play: ${v.title}`}>
                <img src={thumb(v.id)} alt="" loading="lazy" width="270" height="480" />
                <span class="play" aria-hidden="true"></span>
              </button>
              <h3>{v.title}</h3>
              <p class="meta">{fmtDate(v.published)}{v.length ? ` · ${v.length}` : ''}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="vid-section">
    <div class="container cta">
      <p>Zeroed is the pay-once, offline envelope budgeting app the videos use. <a href="/zeroed/?ref=videos">See the app</a> · <a href="https://www.youtube.com/@Zeroed-Official?sub_confirmation=1" rel="noopener">Subscribe on YouTube</a></p>
      <p class="note">Videos load from YouTube's privacy-enhanced player only when you press play. This is education about a budgeting method, not financial advice.</p>
    </div>
  </section>
</Layout>

<script>
  // Click-to-play facade: nothing from YouTube loads until the viewer presses play.
  document.querySelectorAll<HTMLButtonElement>('.player').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      frame.title = btn.getAttribute('aria-label') || 'YouTube video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.setAttribute('allowfullscreen', '');
      frame.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      btn.replaceWith(frame);
      frame.className = btn.classList.contains('portrait') ? 'embed portrait' : 'embed';
    });
  });
</script>

<style>
  .vid-hero { padding: 5rem 0 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; opacity: 0.7; margin: 0 0 0.5rem; }
  .vid-hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 1rem; }
  .lead { max-width: 60ch; font-size: 1.1rem; line-height: 1.6; }
  .vid-section { padding: 2.5rem 0 3rem; }
  .vid-section.alt { background: rgba(127,127,127,0.06); }
  .vid-section h2 { margin: 0 0 1.25rem; font-size: 1.6rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem 1.25rem; }
  .grid.shorts { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .card h3 { font-size: 1.05rem; line-height: 1.4; margin: 0.75rem 0 0.25rem; font-weight: 600; }
  .meta { margin: 0; font-size: 0.85rem; opacity: 0.7; }
  .blurb { margin: 0.5rem 0 0; font-size: 0.95rem; line-height: 1.55; opacity: 0.9; }
  .player, .embed { display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid rgba(127,127,127,0.25); border-radius: 10px; overflow: hidden; background: #000; padding: 0; position: relative; cursor: pointer; }
  .player.portrait, .embed.portrait { aspect-ratio: 9 / 16; }
  .player img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s ease; }
  .player:hover img { transform: scale(1.03); }
  .play { position: absolute; inset: 0; margin: auto; width: 64px; height: 44px; border-radius: 12px; background: rgba(0,0,0,0.65); }
  .play::after { content: ''; position: absolute; left: 26px; top: 12px; border-style: solid; border-width: 10px 0 10px 18px; border-color: transparent transparent transparent #fff; }
  .player:hover .play { background: #e62117; }
  .embed { border: 0; }
  .cta p { max-width: 70ch; line-height: 1.6; }
  .note { opacity: 0.75; font-size: 0.9rem; }
</style>
