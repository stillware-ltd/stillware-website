---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Apps — Stillware Ltd"
  description="Browse the Stillware portfolio. Buy-once, own-forever tools built with privacy and performance in mind."
>
    <header class="apps-hero">
        <div class="container">
            <h1>Our Apps</h1>
            <p>Buy once. Own forever. Every Stillware app is local-first, encrypted, and subscription-free.</p>
        </div>
    </header>

    <section class="apps-grid-section">
        <div class="container">
            <!-- Live App -->
            <div class="app-card live reveal">
                <div class="app-card-content">
                    <span class="app-status live-badge">Available Now</span>
                    <div class="app-icon">
                        <img src="/logo.png" alt="Zeroed" width="64" height="64" />
                    </div>
                    <h2>Zeroed</h2>
                    <p class="app-tagline">The Zero-Trust Financial Ledger</p>
                    <p class="app-desc">Privacy-first, zero-based budgeting. AES-256 encrypted, synced via your own Google Drive. No servers, no subscriptions.</p>
                    <div class="app-platforms">
                        <span class="platform-tag">Windows</span>
                        <span class="platform-tag muted">iOS — Soon</span>
                        <span class="platform-tag">Android</span>
                    </div>
                    <a href="/zeroed" class="btn-primary">Explore Zeroed</a>
                </div>
            </div>

            <!-- RankUpChess — Live on Windows + Android -->
            <div class="app-card featured-live reveal">
                <div class="app-card-content">
                    <span class="app-status live-badge">Available Now</span>
                    <div class="app-icon">
                        <img src="/RankUpChess_logo.png" alt="RankUpChess" width="64" height="64" />
                    </div>
                    <h2>RankUpChess</h2>
                    <p class="app-tagline">The Offline Chess Academy for Kids</p>
                    <p class="app-desc">A premium, 100% offline chess academy. 5,000+ puzzles, 10-tier AI engine, interactive lessons, and a parental gate system. Free to play forever — one payment unlocks everything. No data harvesting.</p>
                    <div class="app-platforms">
                        <span class="platform-tag">Windows</span>
                        <span class="platform-tag">Android</span>
                        <span class="platform-tag muted">iOS — Soon</span>
                    </div>
                    <a href="/rankupchess" class="btn-primary chess-cta">Explore RankUpChess</a>
                </div>
            </div>

        </div>
    </section>
</Layout>

<style>
    .apps-hero {
        padding: 12rem 0 4rem;
        text-align: center;
        background: var(--gradient-obsidian);
    }

    .apps-hero h1 {
        font-size: 3.5rem;
        color: #ffffff;
        margin-bottom: 1rem;
    }

    .apps-hero p {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.65);
        max-width: 550px;
        margin: 0 auto;
    }

    .apps-hero-note {
        font-size: 0.95rem !important;
        color: rgba(255, 255, 255, 0.5) !important;
        margin-top: 1.25rem !important;
    }

    .apps-hero-note a {
        color: #60A5FA;
        text-decoration: underline;
        text-decoration-color: rgba(96, 165, 250, 0.4);
        text-underline-offset: 3px;
        transition: text-decoration-color 0.2s ease;
    }

    .apps-hero-note a:hover {
        text-decoration-color: #60A5FA;
    }

    .apps-grid-section {
        padding: 4rem 0 8rem;
    }

    .app-card.live {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.04) 0%, rgba(37, 99, 235, 0.01) 100%);
        border: 2px solid rgba(37, 99, 235, 0.15);
        border-radius: 24px;
        padding: 4rem;
        margin-bottom: 3rem;
        text-align: center;
    }

    .app-card-content {
        max-width: 600px;
        margin: 0 auto;
    }

    .app-status {
        display: inline-block;
        padding: 0.3rem 1rem;
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1.5rem;
    }

    .live-badge { background: rgba(16, 185, 129, 0.1); color: #059669; }
    .dev-badge { background: rgba(37, 99, 235, 0.1); color: var(--color-primary); }
    .soon-badge { background: rgba(245, 158, 11, 0.1); color: #B45309; }

    .app-icon {
        margin-bottom: 1.5rem;
    }

    .app-icon img {
        margin: 0 auto;
    }

    .app-icon-placeholder {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
        border-radius: 16px;
        color: var(--color-primary);
    }

    .app-card h2, .app-card h3 {
        margin-bottom: 0.5rem;
    }

    .app-card h2 { font-size: 2rem; }
    .app-card h3 { font-size: 1.5rem; }

    .app-tagline {
        color: var(--color-primary);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 1rem;
    }

    .app-desc {
        color: var(--color-text-light);
        line-height: 1.6;
        margin-bottom: 1.5rem;
        max-width: 450px;
        margin-left: auto;
        margin-right: auto;
    }

    .app-platforms {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }

    .platform-tag {
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .platform-tag.muted { opacity: 0.5; }

    .upcoming-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .app-card.upcoming {
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: 20px;
        padding: 2.5rem;
        text-align: center;
        transition: all 0.4s var(--transition-premium);
        box-shadow: var(--shadow-premium);
    }

    .app-card.upcoming:hover {
        transform: translateY(-4px);
        border-color: rgba(37, 99, 235, 0.15);
    }

    .notify-form {
        display: flex;
        gap: 0.5rem;
        max-width: 320px;
        margin: 0 auto;
    }

    .notify-form input[type="email"] {
        flex: 1;
        padding: 0.6rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 100px;
        font-size: 0.9rem;
        font-family: var(--font-sans);
        outline: none;
    }

    .notify-form input[type="email"]:focus {
        border-color: var(--color-primary);
    }

    .app-card.featured-live {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.04) 0%, rgba(245, 158, 11, 0.01) 100%);
        border: 2px solid rgba(245, 158, 11, 0.15);
        border-radius: 24px;
        padding: 4rem;
        margin-bottom: 3rem;
        text-align: center;
    }

    .app-card.featured-live .app-icon img {
        border-radius: 16px;
    }

    .chess-cta {
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%) !important;
        border-color: transparent !important;
    }

    .chess-cta:hover {
        background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%) !important;
    }

    @media (max-width: 768px) {
        .apps-hero h1 { font-size: 2.5rem; }
        .upcoming-grid { grid-template-columns: 1fr; }
        .app-card.live { padding: 2.5rem 1.5rem; }
        .app-card.featured-live { padding: 2.5rem 1.5rem; }
    }
</style>
