---
import Layout from '../layouts/Layout.astro';
import { GUIDES } from '../data/guides';
// Help for both apps (31 Oct 2026): the two app guides first, then RankUp Chess and Zeroed help. A protected page
// (seo/protected-urls.txt): URL, title and H1 unchanged; words added and out-of-date Zeroed lines corrected, none cut.
---

<Layout
  title="Support — Stillware Ltd"
  description="Get help with Stillware apps: free guides to RankUp Chess and Zeroed (read online or print), Google Drive sync setup, data export, and common questions."
>
    <header class="support-hero">
        <div class="container">
            <h1>Support</h1>
            <p>Everything you need to get the most out of your Stillware apps.</p>
        </div>
    </header>

    <section class="support-content">
        <div class="container">
            <h2 class="support-section-title">App guides</h2>
            <p class="support-section-lead">Short guides to where everything is in each app. Read them here, or print the PDF and keep it by the device.</p>
            <div class="guide-grid">
                <div class="guide-card guide-rankup reveal">
                    <img src="/guides/rankupchess/rook.svg" alt="" width="72" height="72" loading="lazy" />
                    <div>
                        <h3>A grown-up's guide to RankUp Chess</h3>
                        <p>For parents, grandparents and teachers: where to start, where everything is, what grown-ups control, and what is free.</p>
                        <div class="guide-links">
                            <a href={GUIDES.rankup.page} class="btn-text">Read the guide &rarr;</a>
                            <a href={GUIDES.rankup.pdf} download class="guide-pdf">Print it ({GUIDES.rankup.label})</a>
                        </div>
                    </div>
                </div>
                <div class="guide-card guide-zeroed reveal">
                    <img src="/guides/zeroed/zeroed-logo.png" alt="" width="72" height="72" loading="lazy" />
                    <div>
                        <h3>Getting started with Zeroed</h3>
                        <p>Set up in four steps, the five tabs, logging and importing spending, and keeping your budget safe.</p>
                        <div class="guide-links">
                            <a href={GUIDES.zeroed.page} class="btn-text">Read the guide &rarr;</a>
                            <a href={GUIDES.zeroed.pdf} download class="guide-pdf">Print it ({GUIDES.zeroed.label})</a>
                        </div>
                    </div>
                </div>
            </div>

            <h2 class="support-section-title">RankUp Chess</h2>
            <div class="support-grid">
                <div class="support-card reveal">
                    <div class="support-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    </div>
                    <h3>Getting Started</h3>
                    <p>Download RankUp Chess free for iPhone, iPad, Android, Windows or Mac. Pick who's playing, then press the big green Continue button: it always starts the next lesson, today's puzzle or a game against the right bot. Settings, purchases and the Parent Dashboard sit behind a grown-up check.</p>
                    <a href={GUIDES.rankup.page} class="btn-text">Read the grown-up's guide &rarr;</a>
                </div>

                <div class="support-card reveal">
                    <div class="support-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <h3>FAQ</h3>
                    <ul>
                        <li><strong>Does it need the internet?</strong> — No. Lessons, puzzles and bots all work offline.</li>
                        <li><strong>We bought it on another device.</strong> — On the unlock screen, tap Restore Purchase; bought on a different kind of device, sign in there with the email you bought with.</li>
                        <li><strong>How do I set a time limit?</strong> — Settings → Healthy play: a daily limit, a bedtime and break reminders.</li>
                    </ul>
                    <a href="/rankupchess/" class="btn-text">More about RankUp Chess &rarr;</a>
                </div>
            </div>

            <h2 class="support-section-title">Zeroed</h2>
            <div class="support-grid">
                <div class="support-card reveal">
                    <div class="support-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    </div>
                    <h3>Getting Started</h3>
                    <p>Download Zeroed from the App Store, Google Play or the Microsoft Store, or install it directly on Mac or Windows, and launch it. The app walks you through setting up your first budget, categories, and accounts in under two minutes. The getting-started guide shows every step.</p>
                    <a href={GUIDES.zeroed.page} class="btn-text">Read the getting-started guide &rarr;</a>
                    <a href="/zeroed/#downloads" class="btn-text">Download Zeroed &rarr;</a>
                </div>

                <div class="support-card reveal">
                    <div class="support-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
                    </div>
                    <h3>Google Drive Sync Setup</h3>
                    <p>Zeroed syncs through your personal Google Drive, and only if you turn it on. In the app, open Settings → Google Drive Sync and sign in with your Google account. A <code>ZeroedData</code> folder is created automatically — encrypted on your device before anything is uploaded, and accessible only by Zeroed.</p>
                    <p>Any other device signed into the same Google account, with your budget password, will detect the folder and sync automatically.</p>
                </div>

                <div class="support-card reveal">
                    <div class="support-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </div>
                    <h3>Data Export</h3>
                    <p>Your data is yours. Export your full budget as one zip from Settings → Export full budget, or any account's transactions as CSV, at any time, even after the trial ends. Settings → Backups keeps automatic copies too. If you use Google Drive Sync, you can also access the encrypted database directly.</p>
                </div>

                <div class="support-card reveal">
                    <div class="support-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <h3>FAQ</h3>
                    <ul>
                        <li><strong>How does sync work without servers?</strong> — Through your personal Google Drive. We never see your data.</li>
                        <li><strong>What if I switch phones?</strong> — Turn on Google Drive Sync, sign into the same Google account, enter your budget password, and Zeroed picks up where you left off. No sync? Settings → Backups → Save a copy elsewhere, then Restore from a file.</li>
                        <li><strong>Can I use it offline?</strong> — Yes. Zeroed works fully offline. Sync happens when you reconnect.</li>
                        <li><strong>I forgot my password.</strong> — Nobody can reset it, not even us: it is the only key to your encrypted budget. Write it down when you create a budget.</li>
                    </ul>
                    <a href="/zeroed/#faq" class="btn-text">More Zeroed FAQs &rarr;</a>
                </div>
            </div>

            <div class="contact-section reveal">
                <h2>Still Need Help?</h2>
                <p>Reach out and we'll get back to you as soon as possible.</p>
                <a href="mailto:support@stillwareltd.com" class="btn-primary">Email Support</a>
            </div>
        </div>
    </section>
</Layout>

<style>
    .support-hero {
        padding: 12rem 0 4rem;
        text-align: center;
        background: var(--gradient-obsidian);
    }

    .support-hero h1 { font-size: 3.5rem; color: #ffffff; margin-bottom: 1rem; }
    .support-hero p { font-size: 1.2rem; color: rgba(255, 255, 255, 0.65); }

    .support-content { padding: 4rem 0 8rem; }

    .support-section-title { font-size: 2rem; margin: 0 0 0.6rem; }
    .support-section-lead { color: var(--color-text-light); font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.6rem; }
    .support-grid + .support-section-title { margin-top: 0; }

    .guide-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-bottom: 4rem; }
    .guide-card { display: flex; gap: 1.4rem; align-items: flex-start; padding: 2rem; border-radius: 20px; }
    .guide-card img { flex: none; border-radius: 16px; }
    .guide-card h3 { font-size: 1.35rem; margin: 0 0 0.6rem; }
    .guide-card p { line-height: 1.6; margin: 0 0 1rem; }
    .guide-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; align-items: center; }
    .guide-pdf { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    .guide-rankup { background: #1A1A2E; color: #E7E6F2; }
    .guide-rankup h3 { color: #F5C518; }
    .guide-rankup .btn-text, .guide-rankup .guide-pdf { color: #fff; }
    .guide-zeroed { background: #F8FAFC; border: 1px solid #E2E8F0; }
    .guide-zeroed p { color: var(--color-text-light); }
    .guide-zeroed .guide-pdf { color: #2563EB; }

    .support-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        margin-bottom: 4rem;
    }

    .support-card {
        background: #ffffff;
        padding: 2.5rem;
        border-radius: 20px;
        border: 1px solid rgba(226, 232, 240, 0.6);
        box-shadow: var(--shadow-premium);
        transition: all 0.4s var(--transition-premium);
    }

    .support-card:hover {
        transform: translateY(-4px);
        border-color: rgba(37, 99, 235, 0.15);
    }

    .support-icon {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
        border-radius: 16px;
        color: var(--color-primary);
        margin-bottom: 1.5rem;
    }

    .support-card h3 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .support-card .btn-text + .btn-text { margin-left: 1.2rem; }

    .support-card p {
        color: var(--color-text-light);
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .support-card code {
        background: var(--color-surface);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
    }

    .support-card ul {
        list-style: none;
        padding: 0;
    }

    .support-card li {
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text-light);
        line-height: 1.5;
    }

    .support-card li:last-child { border-bottom: none; }
    .support-card li strong { color: var(--color-secondary); }

    .contact-section {
        text-align: center;
        padding: 4rem;
        background: var(--color-surface);
        border-radius: 24px;
        border: 1px solid var(--color-border);
    }

    .contact-section h2 { font-size: 2rem; margin-bottom: 0.75rem; }
    .contact-section p { color: var(--color-text-light); margin-bottom: 1.5rem; font-size: 1.1rem; }

    @media (max-width: 768px) {
        .support-hero h1 { font-size: 2.5rem; }
        .support-grid, .guide-grid { grid-template-columns: 1fr; }
        .guide-card { flex-direction: column; }
    }
</style>
