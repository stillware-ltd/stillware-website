---
import Layout from '../../layouts/Layout.astro';
import {
  PADDLE_CLIENT_TOKEN,
  PADDLE_PRODUCTS,
  isComingSoon,
  type CheckoutSlug,
} from '../../config/paddle';

export function getStaticPaths() {
  return Object.keys(PADDLE_PRODUCTS).map((slug) => ({
    params: { product: slug },
  }));
}

const { product } = Astro.params;
const config = PADDLE_PRODUCTS[product as CheckoutSlug];

// `getStaticPaths` already restricts the routes, but be defensive.
if (!config) {
  return Astro.redirect('/');
}

const comingSoon = isComingSoon(config);
const unavailableHeading = config.unavailableHeading ?? `${config.name} — Coming Soon`;
const unavailableText =
  config.unavailableText ?? `${config.name} is launching soon. We'll let you know the moment it's available.`;
---

<Layout
  title={`Buy ${config.name} — Stillware Ltd`}
  description={`Complete your purchase of ${config.name}.`}
  noindex
>
  <section class="checkout-page">
    <div class="checkout-content">
      <h1 id="checkout-heading">
        {comingSoon ? unavailableHeading : 'Loading checkout…'}
      </h1>
      <p class="checkout-status" id="checkout-status">
        {comingSoon ? unavailableText : `Opening secure payment window for ${config.name}.`}
      </p>
      {config.licenceNote && <p class="checkout-licence">{config.licenceNote}</p>}
      {config.passesLicence && !comingSoon && <p class="checkout-licence" id="checkout-no-key" hidden></p>}
      <noscript>
        <p class="checkout-error">
          JavaScript is required to complete checkout. Please enable JavaScript
          and reload this page.
        </p>
      </noscript>
      <a href="/" class="btn-secondary">Back to Home</a>
      {config.appStoreUrl && (
        <p class="checkout-alt">
          On iPhone or iPad? Buy inside the app from the
          <a href={config.appStoreUrl} rel="noopener">App Store</a> instead.
        </p>
      )}
    </div>
  </section>

  {!comingSoon && (
    <>
      <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
      <script
        is:inline
        define:vars={{
          token: PADDLE_CLIENT_TOKEN,
          priceId: config.priceId,
          productName: config.name,
          passLicence: config.passesLicence === true,
          successPath: config.successPath ?? '/buy/success',
        }}
      >
        // The Every device upgrade page is opened by the desktop app with ?licence=<64 hex>: the
        // SHA-256 of the buyer's key. Only a value of exactly 64 hex characters is passed on (as
        // Paddle custom data); anything else is ignored. Only the upgrade page uses this.
        function licenceFromSearch(search) {
          const value = new URLSearchParams(search).get('licence');
          return value !== null && /^[0-9a-fA-F]{64}$/.test(value) ? value.toLowerCase() : null;
        }

        (function () {
          const status = document.getElementById('checkout-status');
          const heading = document.getElementById('checkout-heading');

          function showError(msg) {
            heading.innerText = 'Checkout unavailable';
            status.innerHTML =
              msg +
              '<br><br>Need help? Email <a href="mailto:support@stillwareltd.com">support@stillwareltd.com</a>.';
          }

          if (typeof Paddle === 'undefined') {
            showError('Paddle failed to load. Check your internet connection and reload the page.');
            return;
          }

          try {
            Paddle.Initialize({ token: token });
          } catch (e) {
            showError('Failed to initialise Paddle: ' + (e && e.message ? e.message : e));
            return;
          }

          // Optional discount code via ?discount_code=...
          const params = new URLSearchParams(window.location.search);
          const discountCode = params.get('discount_code') || undefined;

          const checkoutOptions = {
            items: [{ priceId: priceId, quantity: 1 }],
            settings: {
              successUrl: window.location.origin + successPath,
            },
          };
          if (discountCode) {
            checkoutOptions.discountCode = discountCode;
          }

          // Without a usable key hash the upgrade still opens, with no custom data: the licence
          // server then makes a new Every device licence and emails its key, so the payment is
          // never lost. Say so before the buyer pays.
          if (passLicence) {
            const licence = licenceFromSearch(window.location.search);
            if (licence) {
              checkoutOptions.customData = { licence: licence };
            } else {
              const note = document.getElementById('checkout-no-key');
              if (note) {
                note.hidden = false;
                note.innerText =
                  'This page was opened without your key from the app, so this payment gives you a new Every device key by email instead of upgrading the key you have.';
              }
            }
          }

          try {
            Paddle.Checkout.open(checkoutOptions);
            heading.innerText = 'Complete your purchase';
            status.innerText =
              'If the checkout window did not open, your browser may have blocked the popup. Reload the page or check your popup blocker.';
          } catch (e) {
            showError('Could not open checkout: ' + (e && e.message ? e.message : e));
          }
        })();
      </script>
    </>
  )}
</Layout>

<style>
  .checkout-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .checkout-content {
    text-align: center;
    max-width: 520px;
  }

  .checkout-licence {
    margin: -1rem 0 2rem;
    font-weight: 600;
  }

  .checkout-alt {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted, #64748b);
  }

  .checkout-content h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .checkout-status {
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .checkout-error {
    color: #b91c1c;
    margin-bottom: 2rem;
  }
</style>
