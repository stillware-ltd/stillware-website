---
import Layout from '../../layouts/Layout.astro';
import { GUIDES, GUIDES_CHECKED } from '../../data/guides';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

// Getting started with Zeroed: the web version of the printable PDF (same content, same screens). Written answer-first
// for "how to use Zeroed". Facts as the app shows them in 1.7 (labels from the 1.7.3 strings) and as /zeroed/ states
// them; no prices (the founder price changes on 14 Feb 2027). Design: Zeroed's own calm white, slate and electric blue.
const G = GUIDES.zeroed;

const STEPS = [
  { img: 's1-password', alt: 'Zeroed: Keep it private, choosing an encryption password', t: 'Create your budget and lock it', d: 'On the first screen tap New budget, then choose an encryption password of at least 8 characters. Your budget stays on this device, locked with it.' },
  { img: 's2-account', alt: 'Zeroed: Where is your money right now, adding a current account', t: 'Add the account you spend from', d: 'Name it, pick Current, Savings or Cash, and type what is in it right now (or leave it blank to start from zero). Have a statement file? Tap Import a statement instead.' },
  { img: 's3-budget', alt: 'Zeroed Budget tab: Ready to Assign at the top, then monthly bills', t: 'Give every pound a job', d: 'Ready to Assign is money without a job yet. On Budget, tap a category and choose how much it gets; keep going until Ready to Assign reaches zero. Auto-assign can do a first pass.' },
  { img: 's4-log', alt: 'Zeroed Log a spend: amount, date, category chips and Save', t: 'Log spending as it happens', d: "Tap + to Log a spend: type the amount, tap a category, Save. Or import your bank's statement once a month and let Zeroed fill it in." },
];

// Markers on the Today capture, as percentages of the cropped image: a rail just left of the screen, help top right.
const TODAY_POINTS = [[1, -4.5, 10.0], [2, -4.5, 29.8], [3, -4.5, 43.5], [4, -4.5, 64.7], [5, 81.0, 82.5], [6, -4.5, 96.0], [7, 85.5, 1.9]];
const TODAY_KEYS = [
  ['Safe to spend today', 'your spending pool shared over the days left, and the date your bills are covered until.'],
  ['Ready to assign', 'money with no job yet; Assign takes you to give it one.'],
  ['Upcoming bills', 'the next few; View all opens the Bills calendar.'],
  ['Goals', 'and, below them, Recent activity. View all opens every goal.'],
  ['+', 'logs a spend or an income, from Today or Budget.'],
  ['The tabs', 'tap one to switch.'],
  ['?', 'explains the screen you are on. On Budget it opens the Quick Start Guide.'],
];
const TABS = [
  { t: 'Budget', d: "This month's plan: Ready to Assign at the top, then your categories in groups, each with what is available. ‹ › change month; the ⋮ menu has Move Money." },
  { t: 'Accounts', d: 'Your net worth and every account. Open one for its transactions, and the buttons to Import a statement, Reconcile with the bank or Export CSV.' },
  { t: 'Reports', d: 'Overview, Cash Flow and Spending, for any dates and accounts; a 30-day forecast and your net-worth trend.' },
  { t: 'Settings', d: 'Your licence, Google Drive Sync, sharing with your household, accounts, categories, payees, import rules, recurring transactions, backups, exports, Migrate from YNAB, security and preferences.' },
];

const TASKS = [
  { t: 'Log a spend', img: 's4-log', steps: ['Tap + on Today or Budget.', 'Type the amount on the keypad.', 'Tap a category, or Select Category.', 'Tap Save.'], note: 'Yesterday changes the date. Pin a favourite to log it in one tap; on a phone there is a Log a spend shortcut on the app icon too.' },
  { t: 'Import a statement', img: 't-import', steps: ['Accounts → open the account → Import.', 'Choose the file: CSV, OFX, QFX, QIF, PDF or ZIP.', "In Review Import, check each row's payee and category; your import rules fill many in.", "Untick anything you don't want, then Import."], note: 'Duplicates are filtered out automatically.' },
  { t: 'Cover an overspend', img: 't-cover', steps: ['An overspent category stays overspent until you cover it.', 'Tap Cover: Cover Overspending opens.', 'Pick the category to take the money From; check the amount.', 'Tap Move.'], note: 'Any time: Budget → ⋮ → Move Money.' },
  { t: 'Bills and goals', img: 't-bills', steps: ['Today → Upcoming bills → View all: the month as a calendar, each bill marked Assigned, Partial or Unfunded.', "Today → Goals → View all: each goal's progress and projected finish; Set up a goal adds one.", 'Paying off debts? The Goals page has a debt payoff planner (snowball or avalanche).'], note: '' },
];
const SHOT_SIZE: Record<string, [number, number]> = {
  's1-password': [520, 917], 's2-account': [520, 917], 's3-budget': [520, 917], 's4-log': [520, 917],
  't-import': [520, 989], 't-cover': [520, 657], 't-bills': [520, 773],
};

const SAFE = [
  { t: 'Your password', d: 'Nobody can reset it, not even us. About once a month Zeroed asks for it, so it stays fresh in your memory. On a phone, Settings → Security → Biometric Unlock lets your face or fingerprint open it day to day.', key: true },
  { t: 'Backups', d: 'Settings → Backups: automatic daily or weekly copies, Back up now, Save a copy elsewhere and Restore from a file. Zeroed also keeps a copy before any update that changes the file format.' },
  { t: 'Google Drive Sync', d: 'Optional. Settings → Google Drive Sync keeps a copy in your own Drive, encrypted on your device before it is uploaded. Zeroed can only see the files it creates there.' },
  { t: 'Export', d: 'Settings → Export full budget: everything, as one zip you own. Each account can also Export CSV. After the trial, exporting still works.' },
  { t: 'Your licence', d: 'Bought Zeroed on another device? Settings → Activate License Key. Your licence and your budget are separate: syncing the budget is its own choice.' },
  { t: 'Coming from YNAB?', d: 'Settings → Migrate from YNAB brings accounts, categories, assignments and history across from a YNAB export.' },
];

const faqItems = [
  { q: 'Can I reset my Zeroed password?', a: 'No. The password is the only key to your encrypted budget, so nobody can reset it, not even Stillware. Write it down when you create the budget; Zeroed asks for it about once a month so you remember it.' },
  { q: 'How do I move my Zeroed budget to a new device?', a: 'Either turn on Google Drive Sync in Settings on both devices, or use Settings → Backups → Save a copy elsewhere on the old device and Restore from a file on the new one. You need your password either way.' },
  { q: 'Where do I import a bank statement in Zeroed?', a: 'Accounts → open the account → Import. Zeroed reads CSV, OFX, QFX, QIF, PDF and ZIP files, shows every row in Review Import, and filters out duplicates.' },
  { q: 'What happens when the Zeroed trial ends?', a: 'Every feature is unlocked for the first 34 days, with no card. Afterwards Zeroed becomes read-only: you can still browse and export everything. One payment keeps it unlocked, with no subscription.' },
  { q: 'Where is help inside Zeroed?', a: 'Every tab has a ? in its top bar that explains that screen. On Budget it opens the Quick Start Guide.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="How to Use Zeroed: Getting Started Guide"
  description="How to use Zeroed: set up in four steps, find your way round the five tabs, log and import spending, and keep your budget safe. Read it here or print the PDF."
  canonical="https://www.stillwareltd.com/zeroed/guide/"
  breadcrumbs={[{ name: 'Zeroed', href: '/zeroed/' }, { name: 'Getting started guide', href: '/zeroed/guide/' }]}
>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <div class="zg-page">
        <header class="zg-hero">
            <div class="zg-wrap">
                <p class="zg-brand"><img src="/guides/zeroed/zeroed-logo.png" alt="" width="36" height="36" /> Zeroed</p>
                <h1>How to Use Zeroed: Getting Started in Four Steps</h1>
                <p class="zg-answer">Create a budget and lock it with a password only you know, add the account you spend from, then give every pound or dollar a job on the <strong>Budget</strong> tab until Ready to Assign reaches zero. Log each spend with <strong>+</strong>. The five tabs, Today, Budget, Accounts, Reports and Settings, hold everything else.</p>
                <div class="zg-actions">
                    <a class="zg-btn" href={G.pdf} download>Print the guide ({G.label})</a>
                    <a class="zg-link" href="/zeroed/">Get Zeroed: 34 days free</a>
                </div>
            </div>
        </header>

        <section class="zg-section">
            <div class="zg-wrap">
                <p class="zg-eyebrow">Set up in four steps</p>
                <h2>How do you set up Zeroed?</h2>
                <ol class="zg-steps">
                    {STEPS.map((s, i) => (
                        <li>
                            <img src={`/guides/zeroed/${s.img}.webp`} alt={s.alt} width="520" height="917" loading="lazy" />
                            <span class="zg-num">{i + 1}</span>
                            <h3>{s.t}</h3>
                            <p>{s.d}</p>
                        </li>
                    ))}
                </ol>
                <p class="zg-note zg-warn"><strong>Write it down.</strong> Your password is the only key. Without it the budget can't be opened, and nobody can reset it: not even us.</p>
                <p class="zg-note"><strong>34 days free.</strong> Every feature is unlocked for your first 34 days, with no card. Afterwards Zeroed stays readable and exportable; one payment keeps it unlocked, with no subscription.</p>
            </div>
        </section>

        <section class="zg-section zg-tint">
            <div class="zg-wrap zg-tabs">
                <figure class="zg-phone zg-today">
                    <div class="zg-phone-inner">
                        <img src="/guides/zeroed/today.webp" alt="The Zeroed Today tab: safe to spend, ready to assign, upcoming bills, goals and the five tabs" width="720" height="1490" loading="lazy" />
                        {TODAY_POINTS.map(([n, x, y]) => <span class="zg-co" style={`left:${x}%;top:${y}%`} aria-hidden="true">{n}</span>)}
                    </div>
                    <figcaption>The Today tab, with a demo budget in pounds. Your own currency shows instead.</figcaption>
                </figure>
                <div>
                    <p class="zg-eyebrow">Find your way</p>
                    <h2>What is on each of Zeroed's five tabs?</h2>
                    <p class="zg-lead">They sit along the bottom of a phone, or down the left side of a tablet or computer.</p>
                    <h3>Today, at a glance</h3>
                    <ol class="zg-keys">
                        {TODAY_KEYS.map(([k, v]) => <li><strong>{k}</strong>: {v}</li>)}
                    </ol>
                    <table class="zg-table">
                        <tbody>
                            {TABS.map((t) => <tr><th scope="row">{t.t}</th><td>{t.d}</td></tr>)}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="zg-section">
            <div class="zg-wrap">
                <p class="zg-eyebrow">Everyday</p>
                <h2>How do you log, import and cover spending in Zeroed?</h2>
                <div class="zg-tasks">
                    {TASKS.map((t) => (
                        <article>
                            <div>
                                <h3>{t.t}</h3>
                                <ol>{t.steps.map((s) => <li>{s}</li>)}</ol>
                                {t.note && <p class="zg-where">{t.note}</p>}
                            </div>
                            <img src={`/guides/zeroed/${t.img}.webp`} alt={`Zeroed: ${t.t}`} width={SHOT_SIZE[t.img][0]} height={SHOT_SIZE[t.img][1]} loading="lazy" />
                        </article>
                    ))}
                </div>
                <p class="zg-note"><strong>Reconcile.</strong> Once a month, match an account to your bank: Accounts → the account → Reconcile, type the statement balance, and Zeroed shows the difference. It can add a balancing adjustment that you can delete later.</p>
            </div>
        </section>

        <section class="zg-section zg-tint">
            <div class="zg-wrap">
                <p class="zg-eyebrow">Keep it yours</p>
                <h2>How do you keep your Zeroed budget safe?</h2>
                <div class="zg-safe">
                    {SAFE.map((s) => <div class={s.key ? 'zg-key' : ''}><h3>{s.t}</h3><p>{s.d}</p></div>)}
                </div>
            </div>
        </section>

        <section class="zg-section">
            <div class="zg-wrap">
                <h2>Frequently asked questions</h2>
                <div class="zg-faq">
                    {faqItems.map((f) => (<div><h3>{f.q}</h3><p>{f.a}</p></div>))}
                </div>
                <div class="zg-print">
                    <div>
                        <h3>Keep it on paper</h3>
                        <p>The same guide as a 4-page A4 PDF, with the screens and an "I want to… → Go to" table.</p>
                    </div>
                    <a class="zg-btn" href={G.pdf} download>Download the PDF</a>
                </div>
                <div class="zg-news">
                    <NewsletterSignup placement="zeroed-guide" heading="Hear when Zeroed changes" promise="One email when a new version ships or this guide changes, one free budgeting printable or calculator, and one reminder before the founder price ends." />
                </div>
                <p class="zg-checked">Checked against Zeroed {G.version} on {GUIDES_CHECKED}. Source: the app itself; the screens are real captures from versions 1.7.1 and 1.7.2 with a demo budget, unedited. Still stuck? <a href="mailto:support@stillwareltd.com">support@stillwareltd.com</a>. <a href="/support/">All guides and help</a>.</p>
            </div>
        </section>
    </div>
</Layout>

<style>
    .zg-page {
        --navy: #1B365D;
        --head: #0F172A;
        --body: #334155;
        --sub: #64748B;
        --blue: #2563EB;
        --line: #E2E8F0;
        background: #fff;
        color: var(--body);
        font-feature-settings: 'tnum' 1;
    }

    .zg-wrap { width: min(1100px, 100% - 32px); margin-inline: auto; }
    .zg-page h1, .zg-page h2, .zg-page h3 { color: var(--head); letter-spacing: -0.015em; }

    .zg-hero { padding: 9rem 0 3.5rem; background: linear-gradient(180deg, #F1F5F9, #F8FAFC 70%, #fff); border-bottom: 1px solid var(--line); }
    .zg-brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; color: var(--navy); font-size: 1.15rem; margin: 0 0 1.2rem; }
    .zg-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.08; margin: 0 0 1rem; max-width: 820px; }
    .zg-answer { font-size: 1.12rem; line-height: 1.65; color: var(--sub); max-width: 760px; margin-bottom: 1.6rem; }
    .zg-answer strong { color: var(--head); }
    .zg-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; align-items: center; }
    .zg-btn { display: inline-block; background: var(--blue); color: #fff; font-weight: 700; padding: 0.9rem 1.35rem; border-radius: 12px; text-decoration: none; }
    .zg-btn:hover { background: #1D4ED8; }
    .zg-btn:focus-visible, .zg-link:focus-visible { outline: 3px solid #93C5FD; outline-offset: 3px; }
    .zg-link { color: var(--blue); font-weight: 700; }

    .zg-section { padding: 4rem 0; }
    .zg-tint { background: #F8FAFC; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .zg-eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin: 0 0 0.4rem; }
    .zg-section h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.15; margin: 0 0 1.4rem; }
    .zg-section h3 { font-size: 1.08rem; margin: 0 0 0.5rem; }
    .zg-lead { color: var(--sub); line-height: 1.6; margin: -0.6rem 0 1.6rem; }

    .zg-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
    .zg-steps img, .zg-tasks img { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid #CBD5E1; box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06); }
    .zg-num { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 700; margin: 1rem 0 0.6rem; }
    .zg-steps p { line-height: 1.6; color: var(--sub); margin: 0; }
    .zg-note { background: #F8FAFC; border: 1px solid var(--line); border-radius: 12px; padding: 0.9rem 1.1rem; line-height: 1.6; margin: 1.4rem 0 0; }
    .zg-note strong { color: var(--head); }
    .zg-warn { background: #FEF2F2; border-color: #FECACA; }

    .zg-tabs { display: grid; grid-template-columns: 300px 1fr; gap: 3.5rem; align-items: start; }
    .zg-phone { margin: 0 0 0 20px; }
    .zg-phone-inner { position: relative; }
    .zg-phone img { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid #CBD5E1; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08); }
    .zg-phone figcaption { color: var(--sub); font-size: 0.88rem; margin-top: 0.7rem; line-height: 1.5; }
    .zg-co { position: absolute; transform: translate(-50%, -50%); width: 28px; height: 28px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; border: 2px solid #fff; box-shadow: 0 2px 5px rgba(15, 23, 42, 0.25); }
    .zg-keys { padding-left: 1.4rem; display: grid; gap: 0.5rem; line-height: 1.55; margin: 0 0 1.6rem; }
    .zg-keys li::marker { color: var(--blue); font-weight: 700; }
    .zg-keys strong { color: var(--head); }
    .zg-table { width: 100%; border-collapse: collapse; }
    .zg-table th, .zg-table td { text-align: left; vertical-align: top; padding: 0.85rem 0; border-top: 1px solid var(--line); line-height: 1.55; }
    .zg-table th { color: var(--navy); width: 120px; font-weight: 700; }

    .zg-tasks { display: grid; grid-template-columns: 1fr 1fr; gap: 2.2rem 2.5rem; }
    .zg-tasks article { display: grid; grid-template-columns: 1fr 170px; gap: 1.2rem; align-items: start; }
    .zg-tasks ol { padding-left: 1.2rem; margin: 0; display: grid; gap: 0.35rem; line-height: 1.55; }
    .zg-where { color: var(--sub); font-size: 0.92rem; line-height: 1.55; margin: 0.6rem 0 0; }

    .zg-safe { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
    .zg-safe div { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.2rem 1.3rem; }
    .zg-safe p { color: var(--sub); line-height: 1.6; margin: 0; }
    .zg-safe .zg-key { background: #FEF2F2; border-color: #FECACA; }

    .zg-faq { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .zg-faq div { border: 1px solid var(--line); border-radius: 14px; padding: 1.2rem 1.3rem; }
    .zg-faq p { color: var(--sub); line-height: 1.6; margin: 0; }
    .zg-print { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; border-top: 2px solid var(--head); padding-top: 1.6rem; margin-top: 2.2rem; }
    .zg-print p { color: var(--sub); margin: 0; line-height: 1.55; }
    .zg-print .zg-btn { white-space: nowrap; flex: none; }
    .zg-news { margin-top: 2rem; padding: 1.5rem 1.6rem; border: 1px solid var(--line); border-radius: 14px; background: #F8FAFC; }
    .zg-checked { margin-top: 1.4rem; color: var(--sub); font-size: 0.9rem; line-height: 1.6; }
    .zg-checked a { color: var(--blue); font-weight: 600; }

    @media (max-width: 960px) {
        .zg-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .zg-tabs { grid-template-columns: 1fr; }
        .zg-today { max-width: 300px; margin-inline: auto; }
        .zg-tasks { grid-template-columns: 1fr; }
        .zg-safe { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 600px) {
        .zg-hero { padding: 8rem 0 3rem; }
        .zg-steps { grid-template-columns: 1fr; }
        .zg-steps img { max-width: 280px; }
        .zg-tasks article { grid-template-columns: 1fr 120px; }
        .zg-safe, .zg-faq { grid-template-columns: 1fr; }
        .zg-print { flex-direction: column; align-items: flex-start; }
    }
</style>
