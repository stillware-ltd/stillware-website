---
import Layout from '../../layouts/Layout.astro';
import lyrics from '../../data/singalong-lyrics.json';
import { SINGALONG_VIDEO_ID, SINGALONG_KIT_PDF } from '../../data/singalong';

// The free classroom kit for the sing-along "Let the Whole Board Sing" (launch plan D-L3, agreed 30 Oct 2026:
// Marketing/Rank_Up_Chess/Launches/singalong-launch-plan-2026-11.md). The PDF, the board and colouring SVGs and
// src/data/singalong-lyrics.json are built by Marketing/Rank_Up_Chess/Youtube/song/07_production_source/classroom_kit/
// build_kit.py from the song's lyrics and the app's own Sing-Along pieces; rebuild there, never edit them by hand.
// The page talks to the grown-ups who teach; the sheets themselves talk to children and carry no selling words.

const PIECES = [
  { key: 'pawn', name: 'Pawn', move: 'Moves forward one square, or two on its first move, and captures one square on a slant.' },
  { key: 'knight', name: 'Knight', move: 'Jumps in an L: two squares, then one to the side. The only piece that leaps over others.' },
  { key: 'bishop', name: 'Bishop', move: 'Slides any distance on a slant and always stays on its own colour.' },
  { key: 'rook', name: 'Rook', move: 'Runs any distance in straight lines: up, down and sideways.' },
  { key: 'queen', name: 'Queen', move: 'Moves like a Rook and a Bishop together, as far as she likes.' },
  { key: 'king', name: 'King', move: 'Steps one square any way. Trapped in check with no way out is checkmate.' },
];

const LESSON = [
  { t: 'Watch and sing (5 minutes)', d: 'Play the video on the class screen. Hand out the lyric sheet and split the room: grown-ups (or older children) sing the orange lines, children the blue ones, everyone the rainbow choruses.' },
  { t: 'Set up a real board (5 minutes)', d: 'Sing the "Setting up the board" verse slowly while the children place the pieces: rooks in the corners, then knights, bishops, the queen on her own colour, the king, then the pawns.' },
  { t: 'Worksheet (8 minutes)', d: 'Children colour every square each piece can reach. The answer key is the next page of the kit.' },
  { t: 'Colouring for early finishers', d: 'The six Sing-Along pieces, Grandpa King and the little Pawn among them, to colour in.' },
];

const faqItems = [
  { q: 'Is the chess song free to use in class?', a: 'Yes. The video is free to watch on YouTube, and the classroom kit (lyric sheet, worksheet, answer key and colouring page) is free to print and share for non-commercial classroom and home use.' },
  { q: 'Who is the song for?', a: 'Children who are just starting chess, and the grown-ups who teach them: teachers, chess-club coaches, parents and grandparents. Grown-ups and children sing alternate lines, so it works best sung together.' },
  { q: 'What does the song teach?', a: 'How each of the six pieces moves, how to set up the board (a light square in the bottom-right corner, the queen on her own colour), what checkmate means, and that a pawn reaching the far side can become a queen.' },
  { q: 'Where do the Sing-Along pieces come from?', a: 'They are one of the eight board worlds in RankUp Chess, our offline chess academy for kids, and they are free in the app on every platform.' },
  { q: 'Can my school or club use RankUp Chess for free?', a: 'Yes. Classroom licences of RankUp Chess for Windows and Mac computers are free for schools and clubs, with up to 30 profiles on one computer and a lesson plan for every land. Email support@stillwareltd.com and tell us about your class.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const videoSchema = SINGALONG_VIDEO_ID
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: 'Chess Song for Kids – How Every Chess Piece Moves | Let the Whole Board Sing',
      description: 'A sing-along in which Grandpa King teaches the little Pawn how every chess piece moves, how to set up the board and what checkmate means.',
      thumbnailUrl: 'https://www.stillwareltd.com/rankupchess-song/sing-along-video-1280.webp',
      uploadDate: '2026-11-07',
      duration: 'PT4M18S',
      embedUrl: `https://www.youtube-nocookie.com/embed/${SINGALONG_VIDEO_ID}`,
      publisher: { '@id': 'https://www.stillwareltd.com/#organization' },
    }
  : null;
const whoClass = { grown: 'ly-grown', kid: 'ly-kid', everyone: 'ly-all' } as Record<string, string>;
---

<Layout
  title="Chess Song for Kids: Free Sing-Along and Classroom Kit | RankUp Chess"
  description="Let the Whole Board Sing: a free chess song for kids that teaches how every piece moves. Free classroom kit with lyrics, a worksheet, answers and a colouring page."
  canonical="https://www.stillwareltd.com/rankupchess/sing-along/"
>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    {videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}

    <div class="sa-page">
        <header class="sa-hero">
            <div class="sa-wrap sa-hero-grid">
                <div>
                    <p class="sa-kicker">Free for classrooms, clubs and families</p>
                    <h1>Chess Song for Kids: <span>Let the Whole Board Sing</span></h1>
                    <p class="sa-answer"><strong>Let the Whole Board Sing</strong> is a free four-minute chess song for kids. Grandpa King teaches the little Pawn how every piece moves, how to set up the board and what checkmate means, while grown-ups and children sing alternate lines. The free classroom kit adds a lyric sheet, a worksheet, answers and a colouring page.</p>
                    <div class="sa-actions">
                        <a class="sa-btn" href={SINGALONG_KIT_PDF} download data-kit-download>Download the free kit (PDF, 6 pages)</a>
                        <a class="sa-link" href="#lyrics">Read the lyrics</a>
                    </div>
                </div>
                <figure class="sa-video">
                    {SINGALONG_VIDEO_ID ? (
                        <button type="button" class="sa-play" data-video-id={SINGALONG_VIDEO_ID} aria-label="Play the chess song Let the Whole Board Sing">
                            <img src="/rankupchess-song/sing-along-video-1280.webp" srcset="/rankupchess-song/sing-along-video-640.webp 640w, /rankupchess-song/sing-along-video-1280.webp 1280w" sizes="(max-width: 820px) 100vw, 560px" alt="Grandpa King and the little Pawn from the chess song Let the Whole Board Sing" width="1280" height="720" />
                            <span class="sa-play-icon" aria-hidden="true"></span>
                        </button>
                    ) : (
                        <img src="/rankupchess-song/sing-along-video-1280.webp" srcset="/rankupchess-song/sing-along-video-640.webp 640w, /rankupchess-song/sing-along-video-1280.webp 1280w" sizes="(max-width: 820px) 100vw, 560px" alt="Grandpa King and the little Pawn from the chess song Let the Whole Board Sing" width="1280" height="720" />
                    )}
                    <figcaption>4 minutes 18 seconds &middot; made for kids</figcaption>
                </figure>
            </div>
        </header>

        <section class="sa-section">
            <div class="sa-wrap">
                <h2>What's in the free classroom kit?</h2>
                <div class="sa-kit">
                    <article><h3>A teacher's page</h3><p>A 20-minute lesson plan built around the song, and how to get free classroom licences of RankUp Chess.</p></article>
                    <article><h3>The lyric sheet</h3><p>Two pages, colour-coded like the video: orange for grown-ups, blue for children, rainbow for everyone.</p></article>
                    <article><h3>A worksheet and answers</h3><p>Six chessboards: colour every square each piece can reach. The answer key shows them with dots.</p></article>
                    <article><h3>A colouring page</h3><p>The six Sing-Along pieces from the video, Grandpa King and the little Pawn among them.</p></article>
                </div>
                <div class="sa-previews" aria-hidden="true">
                    <img src="/rankupchess-song/kit/board-knight.svg" alt="" width="350" height="350" loading="lazy" />
                    <img src="/rankupchess-song/kit/colour-king.svg" alt="" width="240" height="240" loading="lazy" />
                    <img src="/rankupchess-song/kit/colour-pawn.svg" alt="" width="240" height="240" loading="lazy" />
                </div>
                <p class="sa-center"><a class="sa-btn" href={SINGALONG_KIT_PDF} download data-kit-download>Download the free kit (PDF)</a></p>
            </div>
        </section>

        <section class="sa-section sa-tint">
            <div class="sa-wrap">
                <h2>How do you teach chess with the song?</h2>
                <ol class="sa-steps">
                    {LESSON.map((s) => <li><strong>{s.t}.</strong> {s.d}</li>)}
                </ol>
            </div>
        </section>

        <section class="sa-section" id="lyrics">
            <div class="sa-wrap">
                <h2>What are the lyrics of Let the Whole Board Sing?</h2>
                <p class="sa-legend"><span class="ly-grown">Grown-ups sing orange</span><span class="ly-kid">Children sing blue</span><span class="ly-all">Everyone sings the rainbow choruses</span></p>
                <div class="sa-lyrics">
                    {lyrics.map((s) => (
                        <div class="sa-verse">
                            <h3>{s.title}</h3>
                            {s.lines.map((l) => <p class={whoClass[l.who]}>{l.spoken ? <em>{l.text}</em> : l.text}</p>)}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="sa-section sa-tint">
            <div class="sa-wrap">
                <h2>How does each chess piece move?</h2>
                <table class="sa-table">
                    <thead><tr><th scope="col">Piece</th><th scope="col">How it moves</th></tr></thead>
                    <tbody>
                        {PIECES.map((p) => (
                            <tr>
                                <th scope="row"><img src={`/rankupchess-song/kit/colour-${p.key}.svg`} alt="" width="44" height="44" loading="lazy" />{p.name}</th>
                                <td>{p.move}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="sa-section">
            <div class="sa-wrap sa-grownups">
                <p class="sa-label">For grown-ups</p>
                <h2>Where do the Sing-Along pieces come from?</h2>
                <p>The pieces in the video are one of the eight board worlds in <a href="/rankupchess/">RankUp Chess</a>, our offline chess academy for kids, and they are free in the app. RankUp Chess has voiced lessons, more than 30,000 puzzles and friendly bots, with no ads, no chat and no account to play, on iPhone, iPad, Android, Windows and Mac. Classroom licences for Windows and Mac are free for schools and clubs.</p>
            </div>
        </section>

        <section class="sa-section sa-tint">
            <div class="sa-wrap">
                <h2>Frequently asked questions</h2>
                <div class="sa-faq">
                    {faqItems.map((f) => (<div><h3>{f.q}</h3><p>{f.a}</p></div>))}
                </div>
                <p class="sa-checked">Lyrics, kit and facts checked 30 October 2026. Song, video, kit and pieces by Stillware Ltd, from RankUp Chess.</p>
            </div>
        </section>
    </div>
</Layout>

<script>
    document.querySelectorAll<HTMLAnchorElement>('[data-kit-download]').forEach((a) => {
        a.addEventListener('click', () => (window as any).stillTrack?.('singalong_kit_download', {}));
    });
    const play = document.querySelector<HTMLButtonElement>('.sa-play');
    play?.addEventListener('click', () => {
        const id = play.dataset.videoId || '';
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
        frame.title = 'Let the Whole Board Sing, a chess song for kids';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture';
        frame.allowFullscreen = true;
        frame.className = 'sa-frame';
        play.replaceWith(frame);
        (window as any).stillTrack?.('video_play', { video_id: id, place: 'singalong-kit' });
    });
</script>

<style>
    .sa-page {
        --ink: #2E2547;
        --ink-soft: #564C73;
        --grown: #C9651A;
        --kid: #3559C2;
        --button: #5B45C4;
        background: #FFF7EC;
        color: var(--ink);
    }

    .sa-wrap { width: min(1100px, 100% - 32px); margin-inline: auto; }

    .sa-page h1, .sa-page h2, .sa-page h3 {
        font-family: ui-rounded, 'SF Pro Rounded', 'Arial Rounded MT Bold', 'Varela Round', 'Nunito', var(--font-sans);
        color: var(--ink);
    }

    .sa-hero {
        padding: 9rem 0 4rem;
        background: linear-gradient(180deg, #86BDEB 0%, #CFE5F6 70%, #FFF7EC 100%);
    }

    .sa-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; }

    .sa-kicker, .sa-label {
        display: inline-block;
        background: rgba(255, 255, 255, 0.8);
        color: #5B4A8B;
        font-weight: 800;
        font-size: 0.9rem;
        border-radius: 999px;
        padding: 0.35rem 0.9rem;
        margin-bottom: 1rem;
    }

    .sa-label { background: #EFEAFB; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.78rem; }

    .sa-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; margin: 0 0 1rem; }
    .sa-hero h1 span { display: block; color: var(--button); }

    .sa-answer { font-size: 1.1rem; line-height: 1.6; color: var(--ink-soft); margin-bottom: 1.4rem; }
    .sa-answer strong { color: var(--ink); }

    .sa-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }

    .sa-btn {
        display: inline-block;
        background: var(--button);
        color: #fff;
        font-weight: 800;
        padding: 0.95rem 1.4rem;
        border-radius: 16px;
        text-decoration: none;
        box-shadow: 0 4px 0 #3B2C86;
    }

    .sa-btn:hover { background: #4A35AE; }
    .sa-btn:focus-visible, .sa-link:focus-visible { outline: 3px solid #E9962A; outline-offset: 3px; }
    .sa-link { color: var(--button); font-weight: 700; }

    .sa-video { margin: 0; }
    .sa-video img, .sa-play, .sa-video :global(.sa-frame) {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        height: auto;
        border: 0;
        border-radius: 20px;
        box-shadow: 0 16px 36px rgba(46, 37, 71, 0.18);
    }

    .sa-play { position: relative; padding: 0; cursor: pointer; overflow: hidden; background: none; }
    .sa-play img { box-shadow: none; border-radius: 0; }
    .sa-play-icon { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; border-radius: 50%; background: rgba(91, 69, 196, 0.92); }
    .sa-play-icon::after { content: ''; position: absolute; left: 31px; top: 23px; border-left: 24px solid #fff; border-top: 15px solid transparent; border-bottom: 15px solid transparent; }
    .sa-video figcaption { margin-top: 0.6rem; text-align: center; color: var(--ink-soft); font-size: 0.92rem; }

    .sa-section { padding: 4rem 0; }
    .sa-tint { background: #F3EEFC; }
    .sa-section h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.2; margin: 0 0 1.4rem; }
    .sa-center { text-align: center; margin-top: 1.6rem; }

    .sa-kit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    .sa-kit article { background: #fff; border-radius: 20px; padding: 1.3rem; box-shadow: 0 4px 0 rgba(46, 37, 71, 0.08); }
    .sa-kit h3 { font-size: 1.1rem; margin: 0 0 0.4rem; }
    .sa-kit p { color: var(--ink-soft); line-height: 1.5; font-size: 0.98rem; }

    .sa-previews { display: flex; justify-content: center; align-items: flex-end; gap: 1.5rem; margin-top: 2rem; }
    .sa-previews img { background: #fff; border-radius: 16px; padding: 10px; box-shadow: 0 8px 20px rgba(46, 37, 71, 0.1); height: auto; }
    .sa-previews img:first-child { width: 260px; }
    .sa-previews img:not(:first-child) { width: 150px; }

    .sa-steps { padding-left: 1.3rem; display: grid; gap: 0.9rem; max-width: 820px; }
    .sa-steps li { line-height: 1.6; color: var(--ink-soft); }
    .sa-steps strong { color: var(--ink); }

    .sa-legend { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; font-weight: 800; margin-bottom: 1.4rem; }
    .sa-lyrics { column-count: 3; column-gap: 2.4rem; }
    .sa-verse { break-inside: avoid; margin-bottom: 1.3rem; }
    .sa-verse h3 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: #6E5A78; margin: 0 0 0.4rem; }
    .sa-verse p { margin: 0 0 0.25rem; font-weight: 700; line-height: 1.45; }
    .ly-grown { color: var(--grown); }
    .ly-kid { color: var(--kid); }
    .ly-all { color: var(--ink); background: linear-gradient(90deg, #FFF1D9, #FBE3EE, #E5EBFB); border-radius: 6px; padding: 0 0.4rem; display: inline-block; }
    .sa-legend .ly-all { padding: 0.1rem 0.5rem; }

    .sa-table { width: 100%; max-width: 860px; border-collapse: separate; border-spacing: 0 0.5rem; }
    .sa-table th, .sa-table td { text-align: left; padding: 0.7rem 1rem; background: #fff; }
    .sa-table thead th { background: none; color: #6E5A78; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; padding-bottom: 0; }
    .sa-table tbody th { border-radius: 14px 0 0 14px; white-space: nowrap; font-family: ui-rounded, 'Arial Rounded MT Bold', var(--font-sans); }
    .sa-table tbody td { border-radius: 0 14px 14px 0; color: var(--ink-soft); line-height: 1.5; }
    .sa-table tbody th img { vertical-align: middle; margin-right: 0.6rem; }

    .sa-grownups { max-width: 820px; }
    .sa-grownups p { color: var(--ink-soft); line-height: 1.65; font-size: 1.05rem; }
    .sa-grownups a { color: var(--button); font-weight: 700; }

    .sa-faq { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .sa-faq div { background: #fff; border-radius: 18px; padding: 1.3rem; }
    .sa-faq h3 { font-size: 1.05rem; margin: 0 0 0.4rem; }
    .sa-faq p { color: var(--ink-soft); line-height: 1.55; }
    .sa-checked { margin-top: 1.6rem; color: var(--ink-soft); font-size: 0.9rem; }

    @media (max-width: 900px) {
        .sa-kit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sa-lyrics { column-count: 2; }
    }

    @media (max-width: 760px) {
        .sa-hero { padding: 8rem 0 3rem; }
        .sa-hero-grid, .sa-faq { grid-template-columns: 1fr; }
        .sa-lyrics { column-count: 1; }
        .sa-previews img:first-child { width: 180px; }
        .sa-previews img:not(:first-child) { width: 90px; }
        .sa-table tbody th { white-space: normal; }
    }

    @media (max-width: 480px) {
        .sa-kit { grid-template-columns: 1fr; }
    }
</style>
