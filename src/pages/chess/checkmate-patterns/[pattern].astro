---
// One evergreen page per named checkmate pattern (SEO strategy 6.3, 2026-10-07): /chess/checkmate-patterns/<pattern>/.
// The definitions, recognition tips and FAQ live in src/data/checkmate-patterns.json; the worked examples are read from the
// daily puzzle articles themselves (board image, solution, Lichess link), so a new daily puzzle that uses a pattern joins
// its page on the next build. A pattern gets a page only once at least one published daily puzzle uses it.
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import sharp from 'sharp';
import { join } from 'node:path';
import { SITE } from '../../../lib/seo.mjs';
import { PATTERNS, PATTERNS_UPDATED, patternIndex, puzzleLabel } from '../../../lib/guides.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const index = patternIndex(posts);
  return PATTERNS.filter((p) => index.has(p.id)).map((pattern) => ({ params: { pattern: pattern.id }, props: { pattern } }));
}

const { pattern } = Astro.props;
const posts = await getCollection('blog');
const index = patternIndex(posts);
const examples = index.get(pattern.id) ?? [];
const shown = examples.slice(0, 3);
const related = pattern.related.map((id) => PATTERNS.find((p) => p.id === id)).filter((p) => p && index.has(p.id)).slice(0, 3);

const pageUrl = `${SITE}/chess/checkmate-patterns/${pattern.id}/`;
const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const newest = examples.reduce((m, e) => (e.date > m ? e.date : m), new Date(PATTERNS_UPDATED));
const updated = new Date(PATTERNS_UPDATED) > newest ? new Date(PATTERNS_UPDATED) : newest;

// Natural size of each board image (lives in public/) so the browser reserves its space.
async function size(src: string) {
  try {
    const meta = await sharp(join(process.cwd(), 'public', src)).metadata();
    return meta.width && meta.height ? { width: meta.width, height: meta.height } : {};
  } catch {
    return {};
  }
}
const sizes: Record<string, { width?: number; height?: number }> = {};
for (const ex of shown) {
  sizes[ex.puzzleImage.src] = await size(ex.puzzleImage.src);
  if (ex.solutionImage) sizes[ex.solutionImage.src] = await size(ex.solutionImage.src);
}
// "Puzzle 1: White to play after Bd3" -> "White to play after Bd3"
const altOf = (alt: string) => alt.replace(/^Puzzle \d+:\s*/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#page`,
  url: pageUrl,
  name: pattern.title,
  description: pattern.description,
  inLanguage: 'en',
  dateModified: updated.toISOString().slice(0, 10),
  isPartOf: { '@id': `${SITE}/#website` },
  publisher: { '@id': `${SITE}/#organization` },
  about: { '@type': 'Thing', name: pattern.name },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pattern.faq.map(([q, a]: string[]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---

<Layout
  title={pattern.title}
  description={pattern.description}
  breadcrumbs={[
    { name: 'Checkmate patterns', href: '/chess/checkmate-patterns/' },
    { name: pattern.name, href: `/chess/checkmate-patterns/${pattern.id}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header class="pp-hero">
    <div class="container">
      <nav class="pp-crumbs" aria-label="Breadcrumb">
        <a href="/chess/checkmate-patterns/">Checkmate patterns</a> <span>/</span> <span>{pattern.name}</span>
      </nav>
      <h1>{pattern.title}</h1>
      <p class="lead">{pattern.answer}</p>
      <p class="pp-updated">Updated <time datetime={updated.toISOString().slice(0, 10)}>{fmtDate(updated)}</time></p>
    </div>
  </header>

  <main class="pp-content">
    <div class="container pp-narrow">
      <section class="pp-glance" aria-labelledby="glance">
        <h2 id="glance">{pattern.name} at a glance</h2>
        <table>
          <tbody>
            {pattern.glance.map(([k, v]: string[]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
            <tr>
              <th scope="row">Daily puzzles that use it</th>
              <td>{examples.map((e, i) => (<><a href={`/blog/${e.slug}/`}>#{e.number}</a>{i < examples.length - 1 ? ', ' : ''}</>))}</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2>How do you recognise {pattern.np}?</h2>
        <ul>
          {pattern.recognise.map((r: string) => <li>{r}</li>)}
        </ul>
      </section>

      <section>
        <h2>Worked {shown.length === 1 ? 'example' : 'examples'} from the daily puzzles</h2>
        <p>Each position comes from a real game in the open Lichess puzzle database and is checked before it is published. Set it up, look for the pattern, and only then read the solution.</p>
        {shown.map((ex) => (
          <article class="pp-example" id={`puzzle-${ex.number}`}>
            <h3>Daily Chess Puzzle #{ex.number}: {ex.side} to play (rated {ex.rating})</h3>
            <figure>
              <img src={ex.puzzleImage.src} alt={`${pattern.name} example: ${altOf(ex.puzzleImage.alt)}`} loading="lazy" decoding="async" {...sizes[ex.puzzleImage.src]} />
            </figure>
            <p><strong>{ex.side} to play.</strong> {ex.prompt}</p>
            <p>
              Play it on Lichess before reading on: <a href={ex.lichessUrl} rel="noopener">lichess.org/training/{ex.lichessId}</a>.
              {pattern.examples[ex.lichessId]?.fen && <> Position (FEN): <code>{pattern.examples[ex.lichessId].fen}</code></>}
            </p>
            <h4>Solution</h4>
            <ol class="pp-moves">
              {ex.moves.map((m) => <li><strong>{m.san}</strong> — {m.text}</li>)}
            </ol>
            {ex.narrative && <p>{ex.narrative}</p>}
            {ex.solutionImage && (
              <figure>
                <img src={ex.solutionImage.src} alt={`${pattern.name} example, ${ex.solutionImage.alt.replace(/^Puzzle \d+ /, '')}`} loading="lazy" decoding="async" {...sizes[ex.solutionImage.src]} />
              </figure>
            )}
            {pattern.examples[ex.lichessId]?.why && <p class="pp-why"><strong>Why this is {pattern.np}.</strong> {pattern.examples[ex.lichessId].why}</p>}
            <p class="pp-source">Full puzzle article, with the video: <a href={`/blog/${ex.slug}/`}>{puzzleLabel(ex.title)}</a></p>
          </article>
        ))}
      </section>

      <section>
        <h2>What are the common mistakes?</h2>
        <ul>
          {pattern.mistakes.map((m: string) => <li>{m}</li>)}
        </ul>
      </section>

      {pattern.history && (
        <section>
          <h2>Where does the name come from?</h2>
          <p>{pattern.history}</p>
        </section>
      )}

      <section class="pp-faq">
        <h2>{pattern.name} FAQ</h2>
        {pattern.faq.map(([q, a]: string[]) => (
          <div class="pp-faq-item">
            <h3>{q}</h3>
            <p>{a}</p>
          </div>
        ))}
      </section>

      {related.length > 0 && (
        <section>
          <h2>Related checkmate patterns</h2>
          <ul>
            {related.map((r) => <li><a href={`/chess/checkmate-patterns/${r.id}/`}><strong>{r.name}</strong></a>: {r.blurb}</li>)}
          </ul>
          <p><a href="/chess/checkmate-patterns/">See every checkmate pattern</a></p>
        </section>
      )}

      {examples.length > 0 && (
        <section>
          <h2>Every daily puzzle that uses {pattern.np}</h2>
          <ul>
            {examples.map((e) => <li><a href={`/blog/${e.slug}/`}>{puzzleLabel(e.title)}</a></li>)}
          </ul>
        </section>
      )}

      <section class="pp-cta" data-cta-slot="pattern-page">
        <h2>Train checkmate patterns offline</h2>
        <p>RankUp Chess is an offline chess academy for kids: 5,000+ puzzles, 10 AI levels and lessons. Free to play forever, one payment unlocks it all. No ads, no subscription.</p>
        <p>RankUp Chess. No ads, no subscription and it works offline.</p>
        <p><a href="/rankupchess/" class="btn-primary">See RankUp Chess</a></p>
      </section>

      <p class="pp-sources">
        <strong>Sources.</strong> Definitions are written in our own words from
        {pattern.sources.map((s: { name: string; url: string }, i: number) => (<>{i === 0 ? ' ' : i === pattern.sources.length - 1 ? ' and ' : ', '}<a href={s.url} rel="noopener">{s.name}</a></>))}.
        Puzzle positions come from the <a href="https://database.lichess.org/#puzzles" rel="noopener">Lichess open puzzle database</a> (CC0).
      </p>
    </div>
  </main>
</Layout>

<style>
  .pp-hero { padding: 11rem 0 3.5rem; background: var(--gradient-obsidian); }
  .pp-crumbs { margin-bottom: 1.25rem; font-size: 0.9rem; }
  .pp-crumbs a { color: rgba(255, 255, 255, 0.55); text-decoration: none; }
  .pp-crumbs a:hover { color: #ffffff; }
  .pp-crumbs span { color: rgba(255, 255, 255, 0.3); margin: 0 0.4rem; }
  .pp-crumbs span:last-child { color: rgba(255, 255, 255, 0.7); margin: 0; }
  .pp-hero h1 { font-size: 2.7rem; color: #ffffff; margin-bottom: 1rem; max-width: 820px; }
  .pp-hero .lead { font-size: 1.15rem; color: rgba(255, 255, 255, 0.85); max-width: 780px; line-height: 1.65; }
  .pp-updated { margin-top: 1rem; font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); }

  .pp-content { padding: 3.5rem 0 7rem; }
  .pp-narrow { max-width: 820px; margin: 0 auto; }
  .pp-narrow section { margin-bottom: 2.75rem; padding: 0; }
  .pp-narrow h2 { font-size: 1.7rem; margin-bottom: 0.9rem; }
  .pp-narrow h3 { font-size: 1.25rem; margin: 0 0 0.75rem; }
  .pp-narrow h4 { font-size: 1.05rem; margin: 1.25rem 0 0.5rem; }
  .pp-narrow p, .pp-narrow li { line-height: 1.7; }
  .pp-narrow a { color: var(--color-primary); font-weight: 600; }
  .pp-narrow ul, .pp-narrow ol { padding-left: 1.25rem; display: grid; gap: 0.4rem; }

  .pp-glance table { width: 100%; border-collapse: collapse; background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-premium); }
  .pp-glance th, .pp-glance td { text-align: left; padding: 0.7rem 1rem; border-bottom: 1px solid rgba(148, 163, 184, 0.3); vertical-align: top; line-height: 1.5; }
  .pp-glance th { width: 34%; font-weight: 700; background: rgba(148, 163, 184, 0.12); }
  .pp-glance tr:last-child th, .pp-glance tr:last-child td { border-bottom: none; }

  .pp-example { background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8); border-radius: 16px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: var(--shadow-premium); scroll-margin-top: 6rem; }
  .pp-example figure { margin: 1rem 0; }
  .pp-example img { display: block; width: 100%; max-width: 420px; height: auto; border-radius: 10px; }
  .pp-example code { background: rgba(148, 163, 184, 0.18); padding: 0.1rem 0.4rem; border-radius: 6px; font-size: 0.85em; word-break: break-all; }
  .pp-moves { list-style: decimal; }
  .pp-why { background: rgba(37, 99, 235, 0.07); border-left: 4px solid var(--color-primary); padding: 0.75rem 1rem; border-radius: 0 10px 10px 0; }
  .pp-source { margin-bottom: 0; font-size: 0.95rem; }

  .pp-faq-item { margin-bottom: 1.1rem; }
  .pp-faq-item h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .pp-faq-item p { margin: 0; }

  .pp-narrow .pp-cta { background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8); border-radius: 20px; padding: 2rem; box-shadow: var(--shadow-premium); }
  .pp-narrow .pp-cta .btn-primary { color: #ffffff; }
  .pp-sources { font-size: 0.9rem; color: var(--color-text-light); line-height: 1.6; }

  @media (max-width: 768px) {
    .pp-hero { padding: 8.5rem 0 2.5rem; }
    .pp-hero h1 { font-size: 2rem; }
    .pp-glance th { width: 38%; }
    .pp-example { padding: 1.1rem; }
  }
</style>
