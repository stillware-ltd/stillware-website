---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/seo.mjs';

// Checkmate patterns hub (SEO strategy 5.6, 2026-09-29). The daily puzzle posts are templated companions to the YouTube
// Shorts and were 170 impressions and 0 clicks between them, so they are not treated as separate search assets. This page
// is the one page for the topic "chess checkmate patterns": plain-English definitions, and every puzzle post that
// features each pattern, found from the post titles so new daily posts join the hub without an edit here.
// Definitions are written in our own words from the Lichess theme list and Wikipedia's checkmate-pattern article.
// To add a pattern, add a row to `patterns`; a post is listed under every pattern its title names.
type Pattern = { id: string; name: string; match: RegExp; what: string; spot: string };
const patterns: Pattern[] = [
  { id: 'back-rank-mate', name: 'Back-rank mate', match: /back[- ]rank mate/i,
    what: 'A rook or queen checks the king along its home rank (the first rank for White, the eighth for Black), and the king cannot step away because its own pawns are in the way.',
    spot: 'Look for a castled king whose pawns have never moved, and for a rook or queen that can reach the back rank. Making "luft", a pawn move that gives the king an escape square, is the usual defence.' },
  { id: 'arabian-mate', name: 'Arabian mate', match: /arabian mate/i,
    what: 'A rook and a knight trap the king in a corner. The rook checks from the square next to the king, and the knight, two squares away diagonally, protects the rook and covers the last escape square.',
    spot: 'Look for a king on a corner square such as h8 with a knight able to reach f6, and a rook that can land next to the king.' },
  { id: 'anastasias-mate', name: "Anastasia's mate", match: /anastasia['’]?s mate/i,
    what: 'A knight and a rook (or queen) trap the king between the edge of the board and one of its own pieces. The knight takes away the escape squares and the rook or queen gives the check along the edge file.',
    spot: 'Look for a king on the a- or h-file with its own pawn beside it, and a way to open the file for a rook, often after a sacrifice.' },
  { id: 'morphys-mate', name: "Morphy's mate", match: /morphy['’]?s mate/i,
    what: 'A bishop gives the checkmate while a rook and one of the king’s own pawns box the king in.',
    spot: 'Look for a long diagonal pointing at a cornered king, with a rook already controlling the escape squares.' },
  { id: 'pillsburys-mate', name: "Pillsbury's mate", match: /pillsbury['’]?s mate/i,
    what: 'A rook gives the checkmate while a bishop cuts off the king’s escape. It is the mirror of Morphy’s mate, where the bishop gives the check and the rook confines the king.',
    spot: 'Look for a king on the edge, a bishop already covering its flight squares, and an open file for a rook.' },
  { id: 'opera-mate', name: 'Opera mate', match: /opera mate/i,
    what: 'A rook checkmates on the back rank and a bishop protects it. It is named after Paul Morphy’s 1858 game played at the opera in Paris.',
    spot: 'Look for a king that has not castled, with a pawn restricting its movement, and a bishop lined up behind an open file.' },
  { id: 'epaulette-mate', name: 'Epaulette mate', match: /epaulette mate/i,
    what: 'The two squares on either side of the checked king are occupied by its own pieces, like the epaulettes on a uniform, so a queen or rook check from directly in front cannot be escaped.',
    spot: 'Look for a king boxed in on its back rank by its own rooks or other pieces, with a queen or rook able to check from straight ahead.' },
  { id: 'swallows-tail-mate', name: "Swallow's tail mate", match: /swallow['’]?s tail mate/i,
    what: 'A queen delivers the mate while the king’s own pieces block its retreat, and the pieces form a V shape like a swallow’s tail. It is also called the dovetail or Guéridon mate.',
    spot: 'Look for a king hemmed in by two of its own pieces and a queen that can arrive next to it with support.' },
  { id: 'corner-mate', name: 'Corner mate', match: /corner mate/i,
    what: 'A rook or queen confines the king to a corner, and a knight (or another minor piece) delivers the checkmate.',
    spot: 'Look for a king already close to a corner and a knight that can reach a checking square.' },
  { id: 'smothered-mate', name: 'Smothered mate', match: /smothered mate/i,
    what: 'A knight checkmates a king that cannot move because it is surrounded by its own pieces.',
    spot: 'Look for a king in a corner packed in by its own rook and pawns, and a knight that can jump in with check.' },
  { id: 'bodens-mate', name: "Boden's mate", match: /boden['’]?s mate/i,
    what: 'Two bishops on criss-crossing diagonals deliver checkmate to a king blocked in by its own pieces.',
    spot: 'Look for a castled king with friendly pieces beside it and two bishops that can reach crossing diagonals.' },
  { id: 'hook-mate', name: 'Hook mate', match: /hook mate/i,
    what: 'A rook, a knight and a pawn combine for checkmate, with an enemy pawn blocking the king’s escape.',
    spot: 'Look for a king boxed in by its own pawn and a rook and knight that protect each other.' },
];

const all = (await getCollection('blog'))
  .filter((p) => p.data.pillar === 'daily-puzzle')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "Daily Chess Puzzle #14: Morphy's mate, Discovered attack" -> "#14: Morphy's mate, Discovered attack"
const label = (title: string) => title.replace(/^Daily Chess Puzzle\s*/i, '');
const num = (title: string) => Number((title.match(/#(\d+)/) || [])[1] || 0);
const byNumber = (a: any, b: any) => num(a.data.title) - num(b.data.title);

const sections = patterns
  .map((p) => ({ ...p, posts: all.filter((post) => p.match.test(post.data.title)).sort(byNumber) }))
  .filter((s) => s.posts.length > 0);
const mateInN = all.filter((p) => /mate in (two|three|2|3)/i.test(p.data.title)).sort(byNumber);
const allByNumber = [...all].sort(byNumber);

const pageUrl = `${SITE}/chess/checkmate-patterns/`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: 'Chess checkmate patterns explained',
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/#website` },
      publisher: { '@id': `${SITE}/#organization` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: allByNumber.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${SITE}/blog/${p.slug}/`,
          name: label(p.data.title),
        })),
      },
    },
  ],
};
---

<Layout
  title="Checkmate Patterns in Chess: Names, Examples and Puzzles"
  description="Learn the common chess checkmate patterns, from back-rank and Arabian mate to Morphy's mate, with plain-English definitions and a puzzle for each."
  breadcrumbs={[{ name: 'Checkmate patterns', href: '/chess/checkmate-patterns/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <header class="cmp-hero">
    <div class="container">
      <p class="eyebrow">Chess</p>
      <h1>Checkmate patterns, explained</h1>
      <p class="lead">Strong players do not calculate every mate from scratch. They recognise a shape they have seen before. Here are the patterns that keep turning up, what each one is, and a real puzzle to practise it on.</p>
    </div>
  </header>

  <main class="cmp-content">
    <div class="container cmp-narrow">
      <section>
        <h2>Why learn checkmate patterns?</h2>
        <p>A checkmate pattern is a familiar arrangement of pieces that ends the game: the same few shapes recur across thousands of games. If you can name one when you see it, you find the winning move faster and you also spot when your own king is one move from the same fate. The names come from the players, places or shapes they are remembered for, such as Morphy, Pillsbury and the swallow&rsquo;s tail.</p>
        <p>The puzzles linked below come from our daily puzzle series. Each position comes from a real game in the open Lichess database and is engine-verified, and each post has the solution and a video that walks through it. To practise thousands more, <a href="/rankupchess/">RankUp Chess</a> has a library of 5,000+ puzzles you can filter by difficulty and theme, offline and free to play.</p>
      </section>

      <nav class="cmp-toc" aria-label="Patterns on this page">
        <strong>On this page</strong>
        <ul>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
          {mateInN.length > 0 && <li><a href="#mate-in-n">Mate in two and three</a></li>}
          <li><a href="#all-puzzles">All daily puzzles</a></li>
        </ul>
      </nav>

      {sections.map((s) => (
        <section id={s.id} class="cmp-pattern">
          <h2>{s.name}</h2>
          <p>{s.what}</p>
          <p><strong>How to spot it.</strong> {s.spot}</p>
          <p class="cmp-practise"><strong>Practise it:</strong></p>
          <ul>
            {s.posts.map((p) => <li><a href={`/blog/${p.slug}/`}>{label(p.data.title)}</a></li>)}
          </ul>
        </section>
      ))}

      {mateInN.length > 0 && (
        <section id="mate-in-n" class="cmp-pattern">
          <h2>Mate in two and mate in three</h2>
          <p>These are puzzle types rather than patterns: you are told the king can be mated in a set number of moves, and you have to find the forcing sequence. Look at every check, every capture and every threat before you settle on a move; a quiet move that removes the king&rsquo;s last escape square is often the answer.</p>
          <ul>
            {mateInN.map((p) => <li><a href={`/blog/${p.slug}/`}>{label(p.data.title)}</a></li>)}
          </ul>
        </section>
      )}

      <section id="all-puzzles" class="cmp-pattern">
        <h2>All daily chess puzzles</h2>
        <ul>
          {allByNumber.map((p) => <li><a href={`/blog/${p.slug}/`}>{label(p.data.title)}</a></li>)}
        </ul>
      </section>

      <section class="cmp-cta">
        <h2>Train these patterns offline</h2>
        <p>RankUp Chess is an offline chess academy for kids: 5,000+ puzzles, 10 AI strength levels and interactive lessons. It is free to play forever, with no ads and one optional one-time unlock.</p>
        <p><a href="/rankupchess/" class="btn-primary">See RankUp Chess</a> <a href="/blog/best-offline-chess-puzzles-for-kids/" class="cmp-link">Best offline chess puzzles for kids</a></p>
      </section>
    </div>
  </main>
</Layout>

<style>
  .cmp-hero { padding: 12rem 0 4rem; text-align: center; background: var(--gradient-obsidian); }
  .cmp-hero .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; color: rgba(255, 255, 255, 0.55); margin-bottom: 0.75rem; }
  .cmp-hero h1 { font-size: 3.2rem; color: #ffffff; margin-bottom: 1rem; }
  .cmp-hero .lead { font-size: 1.15rem; color: rgba(255, 255, 255, 0.7); max-width: 720px; margin: 0 auto; }

  .cmp-content { padding: 4rem 0 8rem; }
  .cmp-narrow { max-width: 820px; margin: 0 auto; }
  .cmp-narrow section { margin-bottom: 3rem; }
  .cmp-narrow h2 { font-size: 1.8rem; margin-bottom: 0.9rem; }
  .cmp-narrow p, .cmp-narrow li { line-height: 1.7; }
  .cmp-narrow a { color: var(--color-primary); font-weight: 600; }
  .cmp-narrow ul { padding-left: 1.25rem; display: grid; gap: 0.35rem; }

  .cmp-toc { background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8); border-radius: 16px; padding: 1.25rem 1.5rem; margin-bottom: 3rem; box-shadow: var(--shadow-premium); }
  .cmp-toc ul { columns: 2; column-gap: 2rem; margin: 0.75rem 0 0; padding-left: 1.1rem; display: block; }
  .cmp-toc li { break-inside: avoid; margin-bottom: 0.25rem; }

  .cmp-pattern { padding-top: 0.5rem; border-top: 1px solid rgba(148, 163, 184, 0.3); scroll-margin-top: 6rem; }
  .cmp-practise { margin-bottom: 0.25rem; }

  .cmp-cta { background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8); border-radius: 20px; padding: 2rem; box-shadow: var(--shadow-premium); }
  .cmp-cta .btn-primary { color: #ffffff; margin-right: 1rem; }
  .cmp-link { white-space: nowrap; }

  @media (max-width: 768px) {
    .cmp-hero h1 { font-size: 2.3rem; }
    .cmp-toc ul { columns: 1; }
  }
</style>
