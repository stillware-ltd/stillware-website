<script>
    // Local prices (switch day). The HTML shows no figure; this asks the licence server for the
    // visitor's own country price (platform "web": Every device and the upgrade) and fills it in.
    // If it fails, answers slowly or sends nothing usable, the page stays as it is: no figure, and
    // "Your price is shown at checkout". Text goes in with textContent, never as HTML.
    async function showLocalPrices() {
        const slots = document.querySelectorAll<HTMLElement>('[data-price]');
        if (slots.length === 0) return;
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 5000);
        try {
            const res = await fetch('/api/household/prices', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ product: 'rankup', platform: 'web' }),
                signal: controller.signal,
            });
            if (!res.ok) return;
            const data = await res.json();
            const prices = data && typeof data.prices === 'object' ? data.prices : null;
            if (!prices) return;
            let shown = 0;
            slots.forEach((el) => {
                const text = prices[el.dataset.price ?? ''];
                if (typeof text !== 'string' || text.length > 24 || !/\d/.test(text)) return;
                el.textContent = text;
                el.hidden = false;
                shown += 1;
            });
            const note = document.querySelector('[data-price-note]');
            if (note && shown > 0) {
                note.textContent = 'These prices are for your country, in your currency. The final price, with any local tax, is shown at checkout.';
            }
        } catch {
            /* leave the page as it is */
        } finally {
            clearTimeout(timer);
        }
    }

    // Which platform this visitor is on, from the user agent (the same test as /get/). iPadOS 13+
    // asks for the desktop site and reports itself as a Mac; the touch points give it away.
    function visitorPlatform(): string {
        const ua = navigator.userAgent || '';
        const touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
        if (/iPhone|iPad|iPod/.test(ua) || touchMac) return 'ios';
        if (/Android/.test(ua)) return 'android';
        if (/Windows/.test(ua)) return 'windows';
        if (/Macintosh|Mac OS X/.test(ua)) return 'mac';
        return '';
    }

    // Rule W-L2: the visitor's own platform becomes the big first button in every button group;
    // the others stay one line below. Unknown devices keep every option the same size.
    function personaliseGetButtons() {
        const platform = visitorPlatform();
        // Carry ?ref= and utm_* through to Google Play, so Play Console can answer "did YouTube send this install?".
        const qs = location.search;
        document.querySelectorAll<HTMLAnchorElement>('.ru-store[data-platform="android"]').forEach((a) => {
            if (qs.length > 1 && !a.href.includes('referrer=')) a.href += '&referrer=' + encodeURIComponent(qs.slice(1));
        });
        document.querySelectorAll<HTMLElement>('[data-get]').forEach((group) => {
            const mine = group.querySelector<HTMLElement>(`.ru-store[data-platform="${platform}"]`);
            if (!mine) return;
            group.classList.add('has-primary');
            mine.classList.add('is-primary');
            group.prepend(mine);
            const free = mine.querySelector('small');
            if (free) free.textContent = platform === 'ios' || platform === 'android' ? 'Free on' : 'Free download for';
        });
        if (platform === 'windows') document.querySelector<HTMLElement>('[data-win-note]')?.removeAttribute('hidden');
        document.querySelectorAll<HTMLAnchorElement>('.ru-store').forEach((a) => {
            a.addEventListener('click', () => {
                const group = a.closest<HTMLElement>('[data-get]');
                (window as any).stillTrack?.('rankup_get', {
                    platform: a.dataset.platform || '',
                    place: group?.dataset.get || '',
                    primary: a.classList.contains('is-primary') ? 'yes' : 'no',
                });
            });
        });
    }

    // Rule W-L5: the sing-along video loads from YouTube only when the visitor presses play.
    function wireVideo() {
        const btn = document.querySelector<HTMLButtonElement>('.ru-video-play');
        if (!btn) return;
        btn.addEventListener('click', () => {
            const id = btn.dataset.videoId || '';
            const frame = document.createElement('iframe');
            frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
            frame.title = 'Let the Whole Board Sing, a chess sing-along for kids';
            frame.allow = 'autoplay; encrypted-media; picture-in-picture';
            frame.allowFullscreen = true;
            frame.className = 'ru-video-frame';
            btn.replaceWith(frame);
            (window as any).stillTrack?.('video_play', { video_id: id, place: 'rankupchess' });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        showLocalPrices();
        personaliseGetButtons();
        wireVideo();

        // App Slides Carousels — one per wrapper, so the phone and Mac
        // galleries each drive their own scroller.
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('.slides-ui-wrapper').forEach((wrapper) => {
            const slidesContainer = wrapper.querySelector<HTMLElement>('.slides-container');
            const prevBtn = wrapper.querySelector('.slide-nav-btn.prev');
            const nextBtn = wrapper.querySelector('.slide-nav-btn.next');
            if (!slidesContainer || !prevBtn || !nextBtn) return;

            const slideWidth = () => {
                const slide = slidesContainer.querySelector<HTMLElement>('.slide-image');
                return slide ? slide.offsetWidth + 20 : 300;
            };

            const advance = () => {
                const maxScroll = slidesContainer.scrollWidth - slidesContainer.clientWidth;
                if (slidesContainer.scrollLeft >= maxScroll - 10) {
                    slidesContainer.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    slidesContainer.scrollBy({ left: slideWidth(), behavior: 'smooth' });
                }
            };

            prevBtn.addEventListener('click', () => {
                slidesContainer.scrollBy({ left: -slideWidth(), behavior: 'smooth' });
            });
            nextBtn.addEventListener('click', () => {
                slidesContainer.scrollBy({ left: slideWidth(), behavior: 'smooth' });
            });

            if (reduceMotion) return;
            let autoAdvance = setInterval(advance, 5000);
            slidesContainer.addEventListener('mouseenter', () => clearInterval(autoAdvance));
            slidesContainer.addEventListener('mouseleave', () => {
                autoAdvance = setInterval(advance, 5000);
            });
        });
    });
</script>

