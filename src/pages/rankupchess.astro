---
import Layout from '../layouts/Layout.astro';
import KeyFacts from '../components/KeyFacts.astro';
import { SINGALONG_VIDEO_ID, SINGALONG_KIT_PAGE } from '../data/singalong';
import { GUIDES } from '../data/guides';
import NewsletterSignup from '../components/NewsletterSignup.astro';

// The product version, shown wherever the page states which release this is.
const RANKUP_VERSION = '0.11.0';

// SWITCH DAY (KL.7), live from release day (deploy B, the day both stores have approved 0.11.0):
// the pricing section shows two tiers, Every device and "only on one kind of device", with no
// price figure in the HTML. The visitor's own country price is filled in by the script at the
// bottom of this file, from /api/household/prices (the licence server;
// docs/household-licence-server.md). The date below is the founder's (KD-13, KD-47): a purchase
// before it is an earlier buyer's, with Every device free. While it is null, the line "Bought
// RankUp before ...? You already have Every device, free." is left out rather than printed with no date.
const RANKUP_SWITCH_DATE: string | null = '2026-10-28';
const RANKUP_SWITCH_DATE_TEXT = RANKUP_SWITCH_DATE
  ? new Date(`${RANKUP_SWITCH_DATE}T00:00:00Z`).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : null;

// Download URLs derive from their own per-platform constants, which track the
// release asset that actually exists rather than the product version.
// Windows: the earlier installers (0.5.0 and older) were withdrawn with the
// 0.7.0 release; 0.7.0 was published on 2026-09-19 and 0.7.1 the same evening;
// 0.8.0 on 2026-09-25; no Windows installer was built for 0.9.0; 0.10.0 (the
// board-theme update) on 2026-10-13; 0.10.1 (licence keys activate again) on
// 2026-10-14; no Windows installer was built for 0.10.2; 0.10.3 (per-platform
// licences and the voice lead-in) the same day; 0.11.0 (Every device) on release
// day, published (GitHub release v0.11.0, RankUpChess-Setup-0.11.0.exe) before
// this deploy.
// Set this to null to show "coming soon" on the Windows buttons if no
// installer is live.
const RANKUP_WINDOWS_VERSION: string | null = '0.11.0';
const RANKUP_WINDOWS_DOWNLOAD = RANKUP_WINDOWS_VERSION
  ? `https://github.com/stillware-ltd/rankup-chess-releases/releases/download/v${RANKUP_WINDOWS_VERSION}/RankUpChess-Setup-${RANKUP_WINDOWS_VERSION}.exe`
  : null;

// macOS ships Developer ID signed and notarised, so it installs without a
// Gatekeeper warning. Universal binary. 0.8.0 (board themes, macOS 10.15+)
// was published on 2026-09-25; 0.9.0 (the family adventure) on 2026-10-07
// needs macOS 12, so Macs on 10.15 or 11 stay on 0.8.0 (linked from the
// release notes and the releases README); 0.10.0 (the board-theme update) on
// 2026-10-13; 0.10.1 (licence keys activate again) on 2026-10-14; 0.10.2 (per-platform
// licences) and 0.10.3 (voice lead-in) the same day; 0.11.0 (Every device) on release
// day: the release v0.11.0-macos must carry RankUpChess-0.11.0-macOS.dmg (the URL below).
const RANKUP_MACOS_VERSION = '0.11.0';
const RANKUP_MACOS_DOWNLOAD =
  `https://github.com/stillware-ltd/rankup-chess-releases/releases/download/v${RANKUP_MACOS_VERSION}-macos/RankUpChess-${RANKUP_MACOS_VERSION}-macOS.dmg`;

// Mobile store links. The iOS app went live on the App Store on 2026-09-16
// (iPhone and iPad, iOS 15+); the link is country-neutral so Apple picks the
// visitor's storefront. 0.7.0 went live on 2026-09-19, 0.7.1 on 2026-09-22
// and 0.8.0 on 2026-09-25; 0.9.0 went live on the App Store on 2026-10-12.
// Google Play lists 0.9.0 (build 25), updated 2026-10-07 (checked
// 2026-10-13 on the listing's app-info panel). 0.11.0 (Every device) was released on
// both stores on 30 October 2026 (manual release on both).
const RANKUP_PLAY_STORE_URL =
  'https://play.google.com/store/apps/details?id=com.stillware.rankup_chess';
const RANKUP_APP_STORE_URL = 'https://apps.apple.com/app/id6806675796';
const RANKUP_IOS_VERSION = '0.11.0';
const RANKUP_ANDROID_VERSION = '0.11.0';

// The "Current release" line names the platforms already on RANKUP_VERSION,
// then any still catching up. A platform with no version (Windows set to
// null) is left out of both and gets its own "coming soon" sentence.
const RANKUP_PLATFORMS = [
  { names: ['Windows'], version: RANKUP_WINDOWS_VERSION },
  { names: ['macOS'], version: RANKUP_MACOS_VERSION },
  { names: ['iPhone', 'iPad'], version: RANKUP_IOS_VERSION },
  { names: ['Android'], version: RANKUP_ANDROID_VERSION },
];
const listOf = (items: string[]) =>
  items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}` : items.join('');
const RANKUP_CURRENT_ON = listOf(
  RANKUP_PLATFORMS.filter((p) => p.version === RANKUP_VERSION).flatMap((p) => p.names),
);
const RANKUP_CATCHING_UP = listOf(
  RANKUP_PLATFORMS.filter((p) => p.version && p.version !== RANKUP_VERSION).map(
    (p) => `${listOf(p.names)} ${p.names.length > 1 ? 'are' : 'is'} on v${p.version}`,
  ),
);

// The sing-along's video id and the classroom kit live in src/data/singalong.ts (shared with the kit page).

// Every way to get the app, in the order shown when the visitor's device is unknown. The script
// at the bottom of the page moves the one for the visitor's device to the front and makes it the
// big button (research note Marketing/Rank_Up_Chess/SEO/research/
// landing-rankupchess-kids-redesign-2026-10-30.md, rule W-L2).
const GET_OPTIONS = [
  { platform: 'ios', href: RANKUP_APP_STORE_URL, small: 'Download on the', label: 'App Store', external: true },
  { platform: 'android', href: RANKUP_PLAY_STORE_URL, small: 'Get it on', label: 'Google Play', external: true },
  ...(RANKUP_WINDOWS_DOWNLOAD
    ? [{ platform: 'windows', href: RANKUP_WINDOWS_DOWNLOAD, small: 'Download for', label: 'Windows', external: false }]
    : []),
  { platform: 'mac', href: RANKUP_MACOS_DOWNLOAD, small: 'Download for', label: 'Mac', external: false },
];

// The six Sing-Along pieces and how each one moves, in the song's own simple words.
const SONG_PIECES = [
  { file: 'wP', name: 'Pawn', move: 'Steps forward, and takes on a slant.' },
  { file: 'wN', name: 'Knight', move: 'Jumps in an L. The only piece that leaps.' },
  { file: 'wB', name: 'Bishop', move: 'Slides on the slant, corner to corner.' },
  { file: 'wR', name: 'Rook', move: 'Runs in straight lines, like a train.' },
  { file: 'wQ', name: 'Queen', move: 'Straight or slanting, as far as she likes.' },
  { file: 'wK', name: 'King', move: 'One square any way. Keep him safe!' },
];

// What a child does in the app. Every number is counted in the 0.11.0 build (rkmain, build 33):
// assets/lessons (68 lessons in 9 chapters), assets/database/puzzles.json (30,737 puzzles),
// assets/bots/bots.json (12 levelled bots plus 2 seasonal), assets/playground (6 games plus Pawn
// Wars), assets/stories, the 8 board themes in pubspec.yaml (PurchaseConfig.freeBoardThemes).
const ACTIVITIES = [
  { icon: 'wP', title: 'Learn every piece', text: '68 voiced lessons in 9 lands, from the Little Garden for the youngest players to My First Tournament. Rook, the friendly coach, reads every lesson out loud.' },
  { icon: 'wN', title: 'Play bot friends', text: '12 bot friends who play at the right level, from Baby Bean and Sleepy Sloth to The Grand Admiral (Level 10, 2400). Pumpkin Knight visits in the autumn and the Snow Queen in December.' },
  { icon: 'wB', title: 'Solve puzzles', text: 'More than 30,000 puzzles on themed puzzle islands, with Puzzle Dash, a Mate-in-1 Marathon and a fresh Daily Challenge every day. Most come from the Lichess open puzzle database (thank you, Lichess); the easiest were made by our own engine.' },
  { icon: 'wR', title: 'Play games with a twist', text: "Six playground games (Pawn Race, Hungry Rook, Bishop Slide, Knight's Treasure, Queen's Maze and King's Escape), plus Pawn Wars and King of the Hill." },
  { icon: 'wQ', title: 'Story time', text: "A story for every piece, from Pebble the Pawn to The Pawn Who Became a Queen, and famous games told as shows, starting with Morphy's Opera Game." },
  { icon: 'wK', title: 'Play together', text: 'Pass & Play on one screen, or a game between two devices on the same home Wi-Fi with no internet needed. Club tournaments for the whole family.' },
  { icon: 'bQ', title: 'Eight board worlds', text: 'Treehouse, Classic, Coral Reef and Sing-Along are free; Paper Fold, Starship, Castle and Fossil Dig come with Premium. Each has its own pieces, sounds and effects.' },
  { icon: 'bK', title: 'Certificates and streaks', text: "Beat a land's boss to earn its certificate. Three small goals a day keep the streak going, with ranks and stickers along the way." },
];

const TRUST = [
  'No ads. Ever.',
  'No chat, no strangers',
  'Works with no internet',
  'A grown-up gate on settings and buying',
  'Pay once, never a subscription',
];

// Product markup for search: free to play, with a one-time unlock (see the pricing section). No rating markup: none exists yet.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://www.stillwareltd.com/rankupchess/#app',
  name: 'RankUp Chess',
  alternateName: 'RankUp',
  url: 'https://www.stillwareltd.com/rankupchess/',
  description: 'Offline chess academy for kids: 68 voiced lessons, more than 30,000 puzzles and 12 bot friends from 400 to 2400 Elo. Free to play forever, with a one-time unlock. No ads, no subscription.',
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS, Android, Windows, macOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  publisher: { '@id': 'https://www.stillwareltd.com/#organization' },
  // Where to get it: the App Store and Google Play listings, and the direct downloads this page offers (macOS DMG, Windows installer).
  installUrl: [RANKUP_APP_STORE_URL, RANKUP_PLAY_STORE_URL],
  downloadUrl: [RANKUP_MACOS_DOWNLOAD, ...(RANKUP_WINDOWS_DOWNLOAD ? [RANKUP_WINDOWS_DOWNLOAD] : [])],
  sameAs: [RANKUP_APP_STORE_URL, RANKUP_PLAY_STORE_URL],
};

// Key facts (answer-first block). Each line restates something this page already says: the hero, the activity cards, the
// grown-ups' section and the pricing section. Keep them in step with those, not the other way round.
const keyFacts = [
  { term: 'What it is', detail: 'An offline chess academy designed for kids, from absolute beginner to tournament ready: 68 voiced lessons in 9 lands, more than 30,000 puzzles and 12 bot friends, from two gentle starters through Level 1 (Beginner, 400 Elo) up to Level 10 (World Class, 2400 Elo).' },
  { term: 'Platforms', detail: 'Windows, macOS, iPhone and iPad (App Store) and Android (Google Play).' },
  { term: 'Price', detail: 'Free to play forever, with no trial clock and no lockout: the free lands teach every rule of chess. One optional one-time payment unlocks the complete academy: Every device, or only the kind of device you use. Adding Every device later is a smaller extra payment. No subscription. Your price, for your country, is in the pricing section below.' },
  { term: 'Subscription and ads', detail: 'No subscription, no renewal and no ads.' },
  { term: 'Offline and privacy', detail: '100% offline, local-first gameplay. No account, no chat rooms and no data harvesting: games and progress stay on the device.' },
  { term: 'Parents', detail: 'A grown-up gate (hold for 3 seconds, then answer a times-table question, or your own PIN) guards settings, profile resets and buying, while kids can launch the app and start a game in seconds. Grown-ups also get a weekly report and a daily time limit.' },
];

// FAQ (visible below and as FAQPage JSON-LD). Every answer uses only what this page already states elsewhere.
const faqItems = [
  { q: 'Does RankUp Chess work offline?', a: 'Yes. RankUp Chess is a 100% offline chess academy: playing, puzzles and lessons run on your device without an internet connection. Games and progress stay on the device, and it has no chat rooms. It goes online only to buy or restore the upgrade and, on a computer, to check its licence key.' },
  { q: 'Is RankUp Chess made for kids?', a: 'Yes. It is an offline chess academy designed for kids, from absolute beginner to tournament ready, with voiced lessons, friendly bots and a story for every piece. A grown-up gate (a 3-second hold and a times-table question, or your own PIN) guards settings, profile resets and buying, while kids can launch the app and jump into a game in seconds.' },
  { q: 'Is RankUp Chess free to play?', a: 'Yes. Playing chess is free forever, with no trial clock and no lockout, on every platform. The free lands teach every rule of chess, and the free game includes five bot friends, Pass & Play with every clock, 3 Daily Challenges every day, one full game review a week and four board worlds, Sing-Along among them. Progress, achievements, settings and parental controls are always free.' },
  { q: 'Is there a subscription, and what does the one-time payment unlock?', a: 'There is no subscription and no renewal. One optional one-time payment unlocks the rest of the academy: all 9 lands, more than 30,000 puzzles, all 12 bot friends up to Level 10, unlimited game review and the Opening Explorer, with all v1.x updates included. You can buy it for every device your family owns, or only for the kind of device you use. Either way you pay once.' },
  { q: 'Does RankUp Chess have ads or collect my child\'s data?', a: 'No ads, and no data harvesting. RankUp Chess has no account, no chat rooms and no analytics, and your child\'s games and progress stay on the device. The only data that leaves it is what a purchase needs, as our privacy policy explains.' },
  { q: 'How many puzzles and AI levels does RankUp Chess have?', a: 'More than 30,000 puzzles, from simple mate-in-ones to advanced middle-game strategies, and 12 bot friends: two gentle starters, then 10 AI strength levels from Level 1 (Beginner, 400 Elo) to Level 10 (World Class, 2400 Elo). There are also 68 voiced lessons in 9 lands. Most puzzles come from the Lichess open puzzle database (CC0), and the easiest ones were made by RankUp\'s own engine.' },
  { q: 'Is there a guide for parents to RankUp Chess?', a: "Yes. A grown-up's guide shows where to start, where everything is in the app, what grown-ups control and what is free. Read it on this site under RankUp Chess, Guide for grown-ups, or print the free 4-page PDF." },
  { q: 'Are the Sing-Along pieces from the song in RankUp Chess?', a: 'Yes. The Sing-Along set from the song "Let the Whole Board Sing" is one of the eight board worlds in RankUp Chess, and it is free on every platform.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="RankUp Chess — The Offline Chess Academy for Kids"
  description="Offline chess academy for kids: 68 voiced lessons, 30,000+ puzzles and 12 bot friends. Free to play forever, one payment unlocks it all. No ads, no subscription."
  canonical="https://www.stillwareltd.com/rankupchess/"
>
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <div class="ru-page">
    <!-- Hero: the song's world, so a family arriving from the video knows where they are (rule W-L1) -->
    <header class="ru-hero">
        <div class="ru-sky" aria-hidden="true">
            <span class="ru-sun"></span>
            <img src="/rankupchess-song/cloud.svg" alt="" class="ru-cloud ru-cloud-a" width="220" height="110" />
            <img src="/rankupchess-song/cloud.svg" alt="" class="ru-cloud ru-cloud-b" width="180" height="90" />
            <img src="/rankupchess-song/cloud.svg" alt="" class="ru-cloud ru-cloud-c" width="140" height="70" />
        </div>
        <div class="ru-hero-inner">
            <div class="ru-hero-copy">
                <p class="ru-kicker">From the sing-along &ldquo;Let the Whole Board Sing&rdquo;</p>
                <h1>
                    <span class="ru-rainbow"><span>Every</span> <span>Pawn</span> <span>can</span> <span>Rank</span> <span>Up</span></span>
                    <span class="ru-h1-sub">The offline chess academy for kids</span>
                </h1>
                <p class="ru-lead"><strong>RankUp Chess</strong> teaches every piece one small step at a time, with voiced lessons, friendly bots and puzzles. Free to download, with no ads, no chat and no internet needed.</p>
                <div class="ru-get" data-get="hero">
                    {GET_OPTIONS.map((o) => (
                        <a href={o.href} class="ru-store" data-platform={o.platform} {...(o.external ? { target: '_blank', rel: 'noopener' } : {})}>
                            <span class="ru-store-icon" aria-hidden="true" data-icon={o.platform}></span>
                            <span class="ru-store-text"><small>{o.small}</small>{o.label}</span>
                        </a>
                    ))}
                </div>
                <p class="ru-get-note">Free on iPhone, iPad, Android, Windows and Mac &middot; v{RANKUP_VERSION}. One optional payment unlocks the whole academy, never a subscription.</p>
                {RANKUP_WINDOWS_DOWNLOAD && (
                    <p class="ru-win-note" data-win-note hidden>The Windows installer isn't code-signed yet, so the first time you run it Windows may say &ldquo;Windows protected your PC&rdquo;. Choose <strong>More info</strong>, then <strong>Run anyway</strong>.</p>
                )}
            </div>
            <div class="ru-hero-art" aria-hidden="true">
                <div class="ru-board">
                    {Array.from({ length: 16 }, (_, i) => <span class={(Math.floor(i / 4) + i) % 2 ? 'dark' : 'light'}></span>)}
                </div>
                <img src="/rankupchess-song/pieces/wK.svg" alt="" class="ru-king" width="240" height="240" />
                <img src="/rankupchess-song/pieces/wP.svg" alt="" class="ru-pawn" width="150" height="150" />
            </div>
        </div>
        <div class="ru-hill" aria-hidden="true"></div>
    </header>

    <!-- Safety facts, where proof would usually go (rule W-L3: true facts, never invented proof) -->
    <section class="ru-trust-band" aria-label="Safe for kids">
        <ul class="ru-trust">
            {TRUST.map((t) => <li><span class="ru-tick" aria-hidden="true">&#10003;</span>{t}</li>)}
        </ul>
    </section>

    <!-- The song's pieces, and the song itself (rules W-L1 and W-L5) -->
    <section class="ru-song" id="sing-along">
        <div class="ru-wrap">
            <div class="ru-section-head">
                <h2>Are the pieces from the song in the app?</h2>
                <p>Yes. The Sing-Along pieces from &ldquo;Let the Whole Board Sing&rdquo;, the King with his glasses, the little Pawn and the rest of the set, are one of the eight board worlds in RankUp Chess. They are free, like the lessons that teach every rule.</p>
            </div>
            <ol class="ru-parade">
                {SONG_PIECES.map((p) => (
                    <li>
                        <span class="ru-parade-square"><img src={`/rankupchess-song/pieces/${p.file}.svg`} alt="" width="96" height="96" loading="lazy" /></span>
                        <strong>{p.name}</strong>
                        <span>{p.move}</span>
                    </li>
                ))}
            </ol>
            <figure class="ru-video">
                {SINGALONG_VIDEO_ID ? (
                    <button type="button" class="ru-video-play" data-video-id={SINGALONG_VIDEO_ID} aria-label="Play the sing-along video Let the Whole Board Sing">
                        <img src="/rankupchess-song/sing-along-video-1280.webp" srcset="/rankupchess-song/sing-along-video-640.webp 640w, /rankupchess-song/sing-along-video-1280.webp 1280w" sizes="(max-width: 760px) 100vw, 720px" alt="Grandpa King and the little Pawn from the sing-along Let the Whole Board Sing" width="1280" height="720" loading="lazy" />
                        <span class="ru-play-icon" aria-hidden="true"></span>
                    </button>
                ) : (
                    <img src="/rankupchess-song/sing-along-video-1280.webp" srcset="/rankupchess-song/sing-along-video-640.webp 640w, /rankupchess-song/sing-along-video-1280.webp 1280w" sizes="(max-width: 760px) 100vw, 720px" alt="Grandpa King and the little Pawn from the sing-along Let the Whole Board Sing" width="1280" height="720" loading="lazy" />
                )}
                <figcaption>&ldquo;Let the Whole Board Sing&rdquo;: Grandpa King teaches the little Pawn how every piece moves. A sing-along for kids and grandparents from RankUp Chess. <a href={SINGALONG_KIT_PAGE}>The lyrics, a worksheet and a colouring page are free in the classroom kit.</a></figcaption>
            </figure>
        </div>
    </section>

    <!-- What a child does (every number counted in the 0.11.0 build) -->
    <section class="ru-activities" id="features">
        <div class="ru-wrap">
            <div class="ru-section-head">
                <h2>What will my child do in RankUp Chess?</h2>
                <p>Everything They Need. Nothing They Don't. A full chess academy that runs on the device, from the very first pawn move to a first tournament.</p>
            </div>
            <div class="ru-cards">
                {ACTIVITIES.map((a) => (
                    <article class="ru-card">
                        <span class="ru-card-icon" aria-hidden="true"><img src={`/rankupchess-song/pieces/${a.icon}.svg`} alt="" width="64" height="64" loading="lazy" /></span>
                        <h3>{a.title}</h3>
                        <p>{a.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <KeyFacts heading="RankUp Chess key facts" facts={keyFacts} accent="gold" />

    <!-- App Slides (captions in these images are current; the stale ones were left out on 2026-10-30) -->
    <section class="slides-section" id="app-slides">
        <div class="ru-wrap">
            <div class="ru-section-head">
                <h2>See RankUp Chess in Action.</h2>
                <p class="slides-sub">A full chess academy on your phone &mdash; running entirely on your device, no internet needed.</p>
            </div>
            <div class="slides-ui-wrapper">
                <button class="slide-nav-btn prev" aria-label="Previous Slide">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>
                <div class="slides-container-wrapper">
                    <div class="slides-container">
                        <img src="/rankupchess-screens/phone_0100_01_adventure_map-560.webp" alt="RankUp Chess: Learn chess on a fun adventure. The adventure map, with Rook the friendly talking chess piece" class="slide-image" width="1017" height="2210" loading="lazy" />
                        <img src="/rankupchess-screens/phone_0100_03_family_profiles-560.webp" alt="RankUp Chess: No ads. No chat. Just chess. Up to 8 family profiles on one device, with no child accounts" class="slide-image" width="1017" height="2210" loading="lazy" />
                        <img src="/rankupchess-screens/phone_0100_05_daily_goals-560.webp" alt="RankUp Chess: Small daily goals, big progress. Today’s Adventure on the home screen, with streaks and ranks" class="slide-image" width="1017" height="2210" loading="lazy" />
                        <img src="/rankupchess-screens/phone_0100_09_daily_challenge-560.webp" alt="RankUp Chess: A fresh puzzle every day. The Daily Challenge, with hints that teach the idea" class="slide-image" width="1017" height="2210" loading="lazy" />
                        <img src="/rankupchess-screens/phone_0100_07_certificate-560.webp" alt="RankUp Chess: A certificate for every land you finish, to save or share" class="slide-image" width="1017" height="2210" loading="lazy" />
                        <img src="/rankupchess-screens/phone_0100_10_fun_games-560.webp" alt="RankUp Chess: Chess with a twist. Pawn Wars, King of the Hill and family club tournaments" class="slide-image" width="1017" height="2210" loading="lazy" />
                        <img src="/rankupchess-screens/phone_0100_08_weekly_report-560.webp" alt="RankUp Chess: See the progress every week. The grown-ups’ weekly report: minutes played, lessons finished and skills practised" class="slide-image" width="1017" height="2210" loading="lazy" />
                    </div>
                </div>
                <button class="slide-nav-btn next" aria-label="Next Slide">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </button>
            </div>
        </div>
    </section>

    <!-- macOS Slides -->
    <section class="slides-section slides-mac" id="mac-slides">
        <div class="ru-wrap">
            <div class="ru-section-head">
                <h2>And the same academy on your Mac.</h2>
                <p class="slides-sub">A native macOS app with the same built-in chess engine &mdash; one purchase, no subscription, still entirely offline.</p>
            </div>
            <div class="slides-ui-wrapper">
                <button class="slide-nav-btn prev" aria-label="Previous Slide">
