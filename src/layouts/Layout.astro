---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE } from '../lib/seo.mjs';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** Apple app id — emits the Smart App Banner meta so Safari on iOS offers the App Store listing. */
  appleAppId?: string;
  /** When true, instruct search engines not to index this page. Also
   * suppresses the canonical link (canonical implies "this URL is the
   * indexable one", which contradicts noindex). Use for transactional
   * pages like checkout that shouldn't appear in search results. */
  noindex?: boolean;
  /** Keep the page out of the index but let crawlers follow its links (thin listing pages such as
   * tag pages with only a few posts). Like `noindex`, this suppresses the canonical link. */
  noindexFollow?: boolean;
  /** Open Graph type: "article" for blog posts (adds article:published_time / modified_time), otherwise "website". */
  ogType?: 'website' | 'article';
  /** Article dates (ISO string or Date) for article:published_time and article:modified_time. */
  published?: string | Date;
  modified?: string | Date;
  /** Trail below Home, e.g. [{ name: 'Blog', href: '/blog/' }, { name: post.title, href: '/blog/slug/' }]. Emits BreadcrumbList. */
  breadcrumbs?: { name: string; href: string }[];
}

const { title, description, canonical, ogImage, noindex = false, noindexFollow = false, appleAppId, ogType = 'website', published, modified, breadcrumbs = [] } = Astro.props;
const keepOutOfIndex = noindex || noindexFollow;
// Netlify serves pretty URLs with a trailing slash and 301s the slash-less
// form, and the sitemap lists slash URLs. Normalise every canonical to the
// slash form so it never points at a redirecting URL (fixes /zeroed).
function withTrailingSlash(href: string): string {
  const u = new URL(href);
  if (!u.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(u.pathname)) u.pathname += '/';
  return u.href;
}
const canonicalURL = withTrailingSlash(canonical || new URL(Astro.url.pathname, Astro.site).href);
const ogImageURL = ogImage || new URL('/StillwareLtd_logo.png', Astro.site).href;
const iso = (d?: string | Date) => (d ? new Date(d).toISOString() : undefined);

// One entity graph on every page: the company and the site it publishes. Pages add their own nodes (SoftwareApplication,
// BlogPosting, ...) and point back here with {"@id"}. sameAs links the profiles that make up the brand's identity.
const orgId = `${SITE}/#organization`;
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Stillware Ltd',
      url: `${SITE}/`,
      logo: `${SITE}/logo.png`,
      description: 'Pay-once apps that run on your device. Honest pricing, no subscriptions — never rent software that sits on your own hard drive.',
      sameAs: [
        'https://www.youtube.com/@StillwareFamilyApps',
        'https://github.com/stillware-ltd',
        'https://dev.to/stillwareltd',
        'https://x.com/stillwareltd',
        'https://mastodon.social/@stillwareltd',
        'https://reddit.com/r/StillwareLtd',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Stillware Ltd',
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
  ],
};
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: withTrailingSlash(new URL(b.href, SITE).href),
      })),
    }
  : null;
---

<!doctype html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0SNXMEKL0N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-0SNXMEKL0N');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {appleAppId && <meta name="apple-itunes-app" content={`app-id=${appleAppId}`} />}
    {/* X-Content-Type-Options and Referrer-Policy are real response headers in netlify.toml; as <meta http-equiv> browsers ignore them. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && noindexFollow && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && published && <meta property="article:published_time" content={iso(published)} />}
    {ogType === 'article' && (modified || published) && <meta property="article:modified_time" content={iso(modified || published)} />}
    <meta property="og:site_name" content="Stillware Ltd" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {!keepOutOfIndex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="alternate" type="application/rss+xml" title="Stillware Ltd Blog" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Organization + WebSite (+ BreadcrumbList when the page has a trail) -->
    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</head>
<body>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    <Footer />

    <script is:inline>
        // Store-click attribution: one GA4 event per click on any link that
        // leads to a store listing or a direct download. Lets the scorecard
        // tie YouTube / blog / Reddit sessions (?ref=...) to install intent.
        document.addEventListener('click', function (ev) {
            var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
            if (!a || typeof window.gtag !== 'function') return;
            var href = a.href || '';
            var store =
                /play\.google\.com/.test(href) ? 'google_play' :
                /apps\.microsoft\.com|microsoft\.com\/store/.test(href) ? 'microsoft_store' :
                /apps\.apple\.com/.test(href) ? 'app_store' :
                /\.dmg(\?|$)/.test(href) ? 'macos_dmg' :
                /\.exe(\?|$)/.test(href) ? 'windows_exe' :
                /\/buy\//.test(href) ? 'buy_page' : null;
            if (!store) return;
            var ref = new URLSearchParams(location.search).get('ref') || '';
            // Which CTA on the page was clicked (2026-09-16): the article template now
            // carries an early strip and an end-of-page banner, and the whole point of
            // the change is to tell their click rates apart.
            var slot = a.closest ? a.closest('[data-cta-slot]') : null;
            window.gtag('event', 'store_click', {
                store: store,
                link_url: href,
                page_path: location.pathname,
                ref: ref,
                position: slot ? slot.getAttribute('data-cta-slot') : 'other'
            });
        }, true);
    </script>

    <script>
        // Scroll Reveal
        document.addEventListener('DOMContentLoaded', () => {
            const revealElements = document.querySelectorAll('.reveal, .reveal-up');
            const revealObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        observer.unobserve(entry.target);
                    }
                });
            }, { root: null, rootMargin: '0px 0px -50px 0px', threshold: 0.15 });
            revealElements.forEach(el => revealObserver.observe(el));
        });
    </script>
</body>
</html>
