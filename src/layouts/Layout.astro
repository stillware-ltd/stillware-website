---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE } from '../lib/seo.mjs';
import { UMAMI } from '../lib/analytics.mjs';
// Inter, self-hosted (was fetched from Google Fonts: a render-blocking third-party stylesheet that also told Google
// about every visitor). Only the Latin subsets are shipped; the browser fetches latin-ext only for characters outside Latin.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
const fontFaces = [
  [interLatinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'],
  [interLatin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'],
]
  .map(([url, range]) => `@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2-variations');unicode-range:${range}}`)
  .join('');

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** Pixel size of `ogImage`, when known: emitted as og:image:width / og:image:height (blog posts pass their hero crop's). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Apple app id — emits the Smart App Banner meta so Safari on iOS offers the App Store listing. */
  appleAppId?: string;
  /** When true, instruct search engines not to index this page. Also
   * suppresses the canonical link (canonical implies "this URL is the
   * indexable one", which contradicts noindex). Use for transactional
   * pages like checkout that shouldn't appear in search results. */
  noindex?: boolean;
  /** Keep the page out of the index but let crawlers follow its links (thin listing pages such as
   * tag pages with only a few posts). Like `noindex`, this suppresses the canonical link. */
  noindexFollow?: boolean;
  /** Open Graph type: "article" for blog posts (adds article:published_time / modified_time), otherwise "website". */
  ogType?: 'website' | 'article';
  /** Article dates (ISO string or Date) for article:published_time and article:modified_time. */
  published?: string | Date;
  modified?: string | Date;
  /** Trail below Home, e.g. [{ name: 'Blog', href: '/blog/' }, { name: post.title, href: '/blog/slug/' }]. Emits BreadcrumbList. */
  breadcrumbs?: { name: string; href: string }[];
}

const { title, description, canonical, ogImage, ogImageWidth, ogImageHeight, noindex = false, noindexFollow = false, appleAppId, ogType = 'website', published, modified, breadcrumbs = [] } = Astro.props;
const keepOutOfIndex = noindex || noindexFollow;
// Netlify serves pretty URLs with a trailing slash and 301s the slash-less
// form, and the sitemap lists slash URLs. Normalise every canonical to the
// slash form so it never points at a redirecting URL (fixes /zeroed).
function withTrailingSlash(href: string): string {
  const u = new URL(href);
  if (!u.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(u.pathname)) u.pathname += '/';
  return u.href;
}
const canonicalURL = withTrailingSlash(canonical || new URL(Astro.url.pathname, Astro.site).href);
// og:image and twitter:image must be absolute https URLs: crawlers and link unfurlers do not resolve a relative path
// (blog posts pass a root-relative hero such as /blog/images/<slug>/hero.png). new URL() leaves an absolute URL as it is.
// Never an SVG: Google, Facebook, LinkedIn and X do not render one as a preview, so an SVG falls back to the default raster.
const ogImageIsSvg = !!ogImage && /\.svg$/i.test(ogImage.split(/[?#]/)[0]);
const usableOgImage = ogImage && !ogImageIsSvg ? ogImage : undefined;
const ogImageURL = new URL(usableOgImage || '/StillwareLtd_logo.png', Astro.site).href;
const iso = (d?: string | Date) => (d ? new Date(d).toISOString() : undefined);

// One entity graph on every page: the company and the site it publishes. Pages add their own nodes (SoftwareApplication,
// BlogPosting, ...) and point back here with {"@id"}. sameAs links the profiles that make up the brand's identity.
const orgId = `${SITE}/#organization`;
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Stillware Ltd',
      url: `${SITE}/`,
      logo: `${SITE}/logo.png`,
      description: 'Pay-once apps that run on your device. Honest pricing, no subscriptions — never rent software that sits on your own hard drive.',
      // Public register entry: STILLWARE LTD, Companies House 16927952 (England and Wales). No street address on purpose.
      identifier: { '@type': 'PropertyValue', propertyID: 'UK Companies House number', value: '16927952' },
      address: { '@type': 'PostalAddress', addressCountry: 'GB' },
      // Same node as the Person on /about/ (src/pages/about.astro), so the founder is one entity across the site.
      founder: { '@type': 'Person', '@id': `${SITE}/about/#founder`, name: 'Tejaswi Dhulipala', url: `${SITE}/about/` },
      // Every official profile. YouTube: both channels from Marketing/channels.md, by id (the form the site links) and by handle.
      // @StillwareFamilyApps was the Zeroed channel's name for 18-22 Sep 2026 only; its handle URL no longer resolves.
      sameAs: [
        'https://www.youtube.com/channel/UCEvncfxFpbDNXkHbeucU75A',
        'https://www.youtube.com/@Zeroed-Official',
        'https://www.youtube.com/channel/UC7r19r2thTxTgzxzFu3aNpQ',
        'https://www.youtube.com/@RankUpChess',
        'https://find-and-update.company-information.service.gov.uk/company/16927952',
        'https://github.com/stillware-ltd',
        'https://dev.to/stillwareltd',
        'https://x.com/stillwareltd',
        'https://mastodon.social/@stillwareltd',
        'https://reddit.com/r/StillwareLtd',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Stillware Ltd',
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
  ],
};
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: withTrailingSlash(new URL(b.href, SITE).href),
      })),
    }
  : null;
---

<!doctype html>
<html lang="en">
<head>
    <!-- Analytics: Umami Cloud, cookieless (src/lib/analytics.mjs). stillTrack() is the one way pages record an event:
         calls made before the deferred tracker has loaded are queued and replayed when it does, and an optional
         callback (used by /get/ to redirect) runs once the event has been handed over. -->
    <script is:inline>
      window.stillTrack = function (name, data, done) {
        var u = window.umami;
        if (u && typeof u.track === 'function') {
          try { Promise.resolve(u.track(name, data)).then(done, done); } catch (e) { if (done) done(); }
          return;
        }
        (window.stillTrack.q = window.stillTrack.q || []).push([name, data, done]);
      };
    </script>
    {UMAMI.websiteId && <link rel="preconnect" href="https://gateway.umami.is" crossorigin />}
    {UMAMI.websiteId && (
      <script
        is:inline
        defer
        src={UMAMI.scriptSrc}
        data-website-id={UMAMI.websiteId}
        data-domains={UMAMI.domains}
        data-do-not-track="true"
        onload="var q=window.stillTrack.q||[];window.stillTrack.q=[];q.forEach(function(a){window.stillTrack(a[0],a[1],a[2]);})"
      ></script>
    )}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {appleAppId && <meta name="apple-itunes-app" content={`app-id=${appleAppId}`} />}
    {/* X-Content-Type-Options and Referrer-Policy are real response headers in netlify.toml; as <meta http-equiv> browsers ignore them. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && noindexFollow && <meta name="robots" content="noindex, follow" />}
    {/* max-image-preview:large lets Google show the page's image at full width in results and Discover. Indexable pages only. */}
    {!keepOutOfIndex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {usableOgImage && ogImageWidth && ogImageHeight && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {usableOgImage && ogImageWidth && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && published && <meta property="article:published_time" content={iso(published)} />}
    {ogType === 'article' && (modified || published) && <meta property="article:modified_time" content={iso(modified || published)} />}
    <meta property="og:site_name" content="Stillware Ltd" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {!keepOutOfIndex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="alternate" type="application/rss+xml" title="Stillware Ltd Blog" href="/rss.xml" />

    <!-- Fonts (self-hosted) -->
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <title>{title}</title>

    <!-- Organization + WebSite (+ BreadcrumbList when the page has a trail) -->
    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</head>
<body>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    <Footer />

    <script is:inline>
        // Store-click attribution: one analytics event per click on any link that
        // leads to a store listing or a direct download. Lets the scorecard
        // tie YouTube / blog / Reddit sessions (?ref=...) to install intent.
        document.addEventListener('click', function (ev) {
            var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
            if (!a || typeof window.stillTrack !== 'function') return;
            var href = a.href || '';
            var store =
                /play\.google\.com/.test(href) ? 'google_play' :
                /apps\.microsoft\.com|microsoft\.com\/store/.test(href) ? 'microsoft_store' :
                /apps\.apple\.com/.test(href) ? 'app_store' :
                /\.dmg(\?|$)/.test(href) ? 'macos_dmg' :
                /\.exe(\?|$)/.test(href) ? 'windows_exe' :
                /zeroed-releases\/.*\.zip(\?|$)/.test(href) ? 'windows_zip' :
                /\/buy\//.test(href) ? 'buy_page' : null;
            if (!store) return;
            var ref = new URLSearchParams(location.search).get('ref') || '';
            // Which CTA on the page was clicked (2026-09-16): the article template now
            // carries an early strip and an end-of-page banner, and the whole point of
            // the change is to tell their click rates apart.
            var slot = a.closest ? a.closest('[data-cta-slot]') : null;
            window.stillTrack('store_click', {
                store: store,
                link_url: href,
                ref: ref,
                position: slot ? slot.getAttribute('data-cta-slot') : 'other'
            });
        }, true);
    </script>

    <script>
        // Scroll Reveal
        document.addEventListener('DOMContentLoaded', () => {
            const revealElements = document.querySelectorAll('.reveal, .reveal-up');
            const revealObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        observer.unobserve(entry.target);
                    }
                });
            }, { root: null, rootMargin: '0px 0px -50px 0px', threshold: 0.15 });
            revealElements.forEach(el => revealObserver.observe(el));
        });
    </script>
</body>
</html>
