---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** When true, instruct search engines not to index this page. Also
   * suppresses the canonical link (canonical implies "this URL is the
   * indexable one", which contradicts noindex). Use for transactional
   * pages like checkout that shouldn't appear in search results. */
  noindex?: boolean;
}

const { title, description, canonical, ogImage, noindex = false } = Astro.props;
// Netlify serves pretty URLs with a trailing slash and 301s the slash-less
// form, and the sitemap lists slash URLs. Normalise every canonical to the
// slash form so it never points at a redirecting URL (fixes /zeroed).
function withTrailingSlash(href: string): string {
  const u = new URL(href);
  if (!u.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(u.pathname)) u.pathname += '/';
  return u.href;
}
const canonicalURL = withTrailingSlash(canonical || new URL(Astro.url.pathname, Astro.site).href);
const ogImageURL = ogImage || new URL('/StillwareLtd_logo.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0SNXMEKL0N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-0SNXMEKL0N');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stillware Ltd" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="alternate" type="application/rss+xml" title="Stillware Ltd Blog" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Stillware Ltd",
        "url": "https://www.stillwareltd.com",
        "logo": "https://www.stillwareltd.com/logo.png",
        "description": "Pay-once apps that run on your device. Honest pricing, no subscriptions — never rent software that sits on your own hard drive.",
        "sameAs": [
            "https://dev.to/stillwareltd",
            "https://x.com/stillwareltd",
            "https://reddit.com/r/StillwareLtd"
        ]
    })} />
</head>
<body>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    <Footer />

    <script is:inline>
        // Store-click attribution: one GA4 event per click on any link that
        // leads to a store listing or a direct download. Lets the scorecard
        // tie YouTube / blog / Reddit sessions (?ref=...) to install intent.
        document.addEventListener('click', function (ev) {
            var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
            if (!a || typeof window.gtag !== 'function') return;
            var href = a.href || '';
            var store =
                /play\.google\.com/.test(href) ? 'google_play' :
                /apps\.microsoft\.com|microsoft\.com\/store/.test(href) ? 'microsoft_store' :
                /apps\.apple\.com/.test(href) ? 'app_store' :
                /\.dmg(\?|$)/.test(href) ? 'macos_dmg' :
                /\.apk(\?|$)/.test(href) ? 'android_apk' :
                /\/buy\//.test(href) ? 'buy_page' : null;
            if (!store) return;
            var ref = new URLSearchParams(location.search).get('ref') || '';
            window.gtag('event', 'store_click', {
                store: store,
                link_url: href,
                page_path: location.pathname,
                ref: ref
            });
        }, true);
    </script>

    <script>
        // Scroll Reveal
        document.addEventListener('DOMContentLoaded', () => {
            const revealElements = document.querySelectorAll('.reveal, .reveal-up');
            const revealObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        observer.unobserve(entry.target);
                    }
                });
            }, { root: null, rootMargin: '0px 0px -50px 0px', threshold: 0.15 });
            revealElements.forEach(el => revealObserver.observe(el));
        });
    </script>
</body>
</html>
