---
// One-click store row. Added 2026-09-12 (growth improvement c54cbd3b).
//
// Why: every landing page on the site — the home page, the 13 /tools calculators and
// every /blog article — sent readers to /zeroed before a store link existed anywhere.
// A store click cost two clicks, and 17 of 224 sessions in a week reached the first one.
// This row puts the store on the page the reader actually landed on.
//
// The App Store is deliberately absent: apps.apple.com/app/id6804301133 404s until the
// 14 Sep release. Add it here (one line) once that link resolves.
//
// Link hrefs are matched by the store_click handler in Layout.astro — keep the .apk and
// .dmg extensions in the URL, or the click stops being counted.
const LATEST_VERSION = '1.3.0';
const RELEASE_BASE = `https://github.com/stillware-ltd/zeroed-releases/releases/download/v${LATEST_VERSION}`;

interface Props {
  label?: string;
}
const { label = 'Or get it straight from your store:' } = Astro.props;
---

<div class="store-links">
  <span class="store-links-label">{label}</span>
  <div class="store-links-row">
    <a href="https://apps.microsoft.com/detail/9NCHJ67Q98C5" target="_blank" rel="noopener" class="store-link">Microsoft Store</a>
    <a href="https://play.google.com/store/apps/details?id=com.stillwareltd.zeroed" target="_blank" rel="noopener" class="store-link">Google Play</a>
    <a href={`${RELEASE_BASE}/Zeroed-${LATEST_VERSION}.dmg`} class="store-link">macOS download</a>
    <a href={`${RELEASE_BASE}/Zeroed-${LATEST_VERSION}.apk`} class="store-link">Android APK</a>
  </div>
</div>

<style>
  .store-links {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .store-links-label {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .store-links-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .store-link {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.85rem;
    text-decoration: none;
    color: inherit;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .store-link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .store-links-row { gap: 0.4rem; }
    .store-link { font-size: 0.8rem; padding: 0.35rem 0.7rem; }
  }
</style>
