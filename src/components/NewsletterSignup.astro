---
// The one newsletter form (src/data/newsletter.ts). Optional everywhere: it sits beside what a page gives away, never in
// front of it. `placement` names where it is, so Buttondown (metadata) and Umami (newsletter_signup, recorded by the
// listener in Layout.astro) can say which places work. `tone` matches the background it sits on.
import { NEWSLETTER } from '../data/newsletter';

interface Props {
  placement: string;
  heading?: string;
  promise?: string;
  button?: string;
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
}

const { placement, heading, promise = NEWSLETTER.promise, button = 'Join', tone = 'light', align = 'left' } = Astro.props;
const id = `nl-${placement.replace(/[^a-z0-9]+/gi, '-')}`;
---

<div class:list={['nl', `nl-${tone}`, `nl-${align}`]}>
    {heading && <p class="nl-heading">{heading}</p>}
    {promise && <p class="nl-promise">{promise}</p>}
    <form class="nl-form" action={NEWSLETTER.action} method="post" data-newsletter={placement}>
        <label class="nl-label" for={id}>Email address</label>
        <input id={id} type="email" name="email" required autocomplete="email" placeholder="your@email.com" />
        <input type="hidden" name="embed" value="1" />
        <input type="hidden" name="metadata__placement" value={placement} />
        <button type="submit">{button}</button>
    </form>
    <p class="nl-terms">{NEWSLETTER.terms} <a href={NEWSLETTER.page}>What you'll get</a></p>
</div>

<style>
    .nl { max-width: 520px; }
    .nl-center { margin-inline: auto; text-align: center; }
    .nl-heading { font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 0.4rem; }
    .nl-promise { line-height: 1.55; margin: 0 0 1rem; }
    .nl-form { display: flex; gap: 0.6rem; }
    .nl-center .nl-form { justify-content: center; }
    .nl-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .nl-form input[type='email'] {
        flex: 1;
        min-width: 0;
        padding: 0.8rem 1.1rem;
        border-radius: 100px;
        font: inherit;
        font-size: 1rem;
        outline: none;
    }
    .nl-form button {
        padding: 0.8rem 1.6rem;
        border: 0;
        border-radius: 100px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }
    .nl-form button:focus-visible, .nl-form input:focus-visible { outline: 3px solid #93C5FD; outline-offset: 2px; }
    .nl-terms { font-size: 0.85rem; line-height: 1.5; margin: 0.7rem 0 0; }
    .nl-terms a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

    .nl-light .nl-heading { color: var(--color-secondary, #0F172A); }
    .nl-light .nl-promise, .nl-light .nl-terms { color: var(--color-text-light, #64748B); }
    .nl-light .nl-terms a { color: var(--color-primary, #2563EB); }
    .nl-light input[type='email'] { border: 1px solid #CBD5E1; background: #fff; color: #0F172A; }
    .nl-light button { background: var(--color-primary, #2563EB); color: #fff; }
    .nl-light button:hover { background: #1D4ED8; }

    .nl-dark .nl-heading { color: #fff; }
    .nl-dark .nl-promise, .nl-dark .nl-terms { color: rgba(255, 255, 255, 0.68); }
    .nl-dark .nl-terms a { color: #fff; }
    .nl-dark input[type='email'] { border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(255, 255, 255, 0.08); color: #fff; }
    .nl-dark input[type='email']::placeholder { color: rgba(255, 255, 255, 0.45); }
    .nl-dark button { background: #fff; color: #0F172A; }
    .nl-dark button:hover { background: #E2E8F0; }

    @media (max-width: 520px) {
        .nl-form { flex-direction: column; }
        .nl-form button { width: 100%; }
    }
</style>
